c function in Python?"}, {"role": "silicat", "content": "Use `asyncio.run()` to start the event loop and run a coroutine:\n\n```python\nimport asyncio\n\nasync def main():\n    print(\"hello\")\n    await asyncio.sleep(1)\n    print(\"world\")\n\nasyncio.run(main())\n```\n\n`asyncio.run()` creates a new event loop, runs the coroutine until it finishes, and closes the loop."}]}
{"messages": [{"role": "user", "content": "Show me a minimal asyncio example."}, {"role": "silicat", "content": "```python\nimport asyncio\n\nasync def greet():\n    await asyncio.sleep(0.5)\n    return \"done\"\n\nresult = asyncio.run(greet())\nprint(result)\n```"}]}
{"messages": [{"role": "user", "content": "What does async/await actually do?"}, {"role": "silicat", "content": "`async def` defines a coroutine, and `await` suspends the coroutine until the awaited operation completes, letting the event loop run other tasks meanwhile:\n\n```python\nimport asyncio\n\nasync def fetch_data():\n    print(\"start\")\n    await asyncio.sleep(2)  # yields control back to the loop\n    print(\"done\")\n    return 42\n\nasyncio.run(fetch_data())\n```\n\nawait doesn't block the whole program; it only pauses that coroutine."}]}
{"messages": [{"role": "user", "content": "How can I sleep without blocking in asyncio?"}, {"role": "silicat", "content": "Use `asyncio.sleep()` instead of `time.sleep()`:\n\n```python\nimport asyncio\n\nasync def worker():\n    print(\"working\")\n    await asyncio.sleep(3)  # non-blocking\n    print(\"finished\")\n\nasyncio.run(worker())\n```\n\n`time.sleep()` blocks the entire event loop; `asyncio.sleep()` lets other coroutines run."}]}
{"messages": [{"role": "user", "content": "Run two coroutines at the same time in asyncio."}, {"role": "silicat", "content": "Use `asyncio.gather()` to run them concurrently:\n\n```python\nimport asyncio\n\nasync def task(name, delay):\n    await asyncio.sleep(delay)\n    return f\"{name} after {delay}s\"\n\nasync def main():\n    results = await asyncio.gather(\n        task(\"A\", 1),\n        task(\"B\", 2),\n    )\n    print(results)\n\nasyncio.run(main())\n```"}]}
{"messages": [{"role": "user", "content": "How do I use asyncio.gather to collect results?"}, {"role": "silicat", "content": "```python\nimport asyncio\n\nasync def square(n):\n    await asyncio.sleep(0.1)\n    return n * n\n\nasync def main():\n    results = await asyncio.gather(*(square(i) for i in range(5)))\n    print(results)  # [0, 1, 4, 9, 16]\n\nasyncio.run(main())\n```\n\n`gather` returns results in the same order as the input coroutines."}]}
{"messages": [{"role": "user", "content": "What's the difference between create_task and gather?"}, {"role": "silicat", "content": "`asyncio.create_task()` schedules a coroutine to run in the background and returns a Task you can await later; `gather()` runs several awaitables concurrently and waits for all of them at once.\n\n```python\nimport asyncio\n\nasync def work(n):\n    await asyncio.sleep(n)\n    return n\n\nasync def main():\n    # create_task: schedule now, await later\n    t1 = asyncio.create_task(work(1))\n    t2 = asyncio.create_task(work(2))\n    print(await t1, await t2)\n\n    # gather: run and wait together\n    print(await asyncio.gather(work(1), work(2)))\n\nasyncio.run(main())\n```"}]}
{"messages": [{"role": "user", "content": "How do I schedule a coroutine to run in the background?"}, {"role": "silicat", "content": "Use `asyncio.create_task()`:\n\n```python\nimport asyncio\n\nasync def background():\n    await asyncio.sleep(1)\n    print(\"background done\")\n\nasync def main():\n    task = asyncio.create_task(background())\n    print(\"doing other work\")\n    await task  # wait for it to finish\n\nasyncio.run(main())\n```"}]}
{"messages": [{"role": "user", "content": "Can you explain coroutines vs tasks in asyncio?"}, {"role": "silicat", "content": "A coroutine is what you get from calling an `async def` function; it doesn't run until awaited. A Task wraps a coroutine and schedules it on the event loop so it starts running immediately in the background.\n\n```python\nimport asyncio\n\nasync def job():\n    await asyncio.sleep(1)\n    return \"ok\"\n\nasync def main():\n    coro = job()                     # not running yet\n    task = asyncio.create_task(coro) # now scheduled and running\n    return await task\n\nasyncio.run(main())\n```"}]}
{"messages": [{"role": "user", "content": "I want to fire off many async tasks and wait for them all."}, {"role": "silicat", "content": "```python\nimport asyncio\n\nasync def process(item):\n    await asyncio.sleep(0.2)\n    return item * 2\n\nasync def main():\n    items = list(range(10))\n    tasks = [asyncio.create_task(process(i)) for i in items]\n    results = await asyncio.gather(*tasks)\n    print(results)\n\nasyncio.run(main())\n```"}]}
{"messages": [{"role": "user", "content": "How do I add a timeout to an async operation?"}, {"role": "silicat", "content": "Use `asyncio.wait_for()`:\n\n```python\nimport asyncio\n\nasync def slow():\n    await asyncio.sleep(10)\n    return \"done\"\n\nasync def main():\n    try:\n        result = await asyncio.wait_for(slow(), timeout=2.0)\n    except asyncio.TimeoutError:\n        print(\"timed out\")\n\nasyncio.run(main())\n```"}]}
{"messages": [{"role": "user", "content": "Use asyncio.timeout context manager."}, {"role": "silicat", "content": "Python 3.11+ has `asyncio.timeout()` as a context manager:\n\n```python\nimport asyncio\n\nasync def slow():\n    await asyncio.sleep(10)\n\nasync def main():\n    try:\n        async with asyncio.timeout(2):\n            await slow()\n    except asyncio.TimeoutError:\n        print(\"operation timed out\")\n\nasyncio.run(main())\n```"}]}
{"messages": [{"role": "user", "content": "How do I limit concurrency with a semaphore in asyncio?"}, {"role": "silicat", "content": "```python\nimport asyncio\n\nasync def fetch(sem, n):\n    async with sem:\n        print(f\"start {n}\")\n        await asyncio.sleep(1)\n        print(f\"end {n}\")\n        return n\n\nasync def main():\n    sem = asyncio.Semaphore(3)  # at most 3 at once\n    await asyncio.gather(*(fetch(sem, i) for i in range(10)))\n\nasyncio.run(main())\n```\n\nThe semaphore caps how many coroutines run inside the `async with` block simultaneously."}]}
{"messages": [{"role": "user", "content": "Explain asyncio.Lock with an example."}, {"role": "silicat", "content": "An `asyncio.Lock` ensures only one coroutine enters a critical section at a time:\n\n```python\nimport asyncio\n\ncounter = 0\nlock = asyncio.Lock()\n\nasync def increment():\n    global counter\n    async with lock:\n        tmp = counter\n        await asyncio.sleep(0.01)\n        counter = tmp + 1\n\nasync def main():\n    await asyncio.gather(*(increment() for _ in range(100)))\n    print(counter)  # 100\n\nasyncio.run(main())\n```"}]}
{"messages": [{"role": "user", "content": "How do I use an asyncio.Event?"}, {"role": "silicat", "content": "An Event lets coroutines wait until something signals them:\n\n```python\nimport asyncio\n\nasync def waiter(event):\n    print(\"waiting\")\n    await event.wait()\n    print(\"go!\")\n\nasync def main():\n    event = asyncio.Event()\n    task = asyncio.create_task(waiter(event))\n    await asyncio.sleep(1)\n    event.set()  # wake up the waiter\n    await task\n\nasyncio.run(main())\n```"}]}
{"messages": [{"role": "user", "content": "Producer/consumer with asyncio.Queue please."}, {"role": "silicat", "content": "```python\nimport asyncio\n\nasync def producer(queue):\n    for i in range(5):\n        await asyncio.sleep(0.1)\n        await queue.put(i)\n    await queue.put(None)  # sentinel\n\nasync def consumer(queue):\n    while True:\n        item = await queue.get()\n        if item is None:\n            break\n        print(\"consumed\", item)\n\nasync def main():\n    queue = asyncio.Queue()\n    await asyncio.gather(producer(queue), consumer(queue))\n\nasyncio.run(main())\n```"}]}
{"messages": [{"role": "user", "content": "How can I run a blocking function inside async code?"}, {"role": "silicat", "content": "Offload it to a thread with `asyncio.to_thread()` so it doesn't block the event loop:\n\n```python\nimport asyncio\nimport time\n\ndef blocking_io():\n    time.sleep(2)  # blocking\n    return \"done\"\n\nasync def main():\n    result = await asyncio.to_thread(blocking_io)\n    print(result)\n\nasyncio.run(main())\n```"}]}
{"messages": [{"role": "user", "content": "What is asyncio.as_completed used for?"}, {"role": "silicat", "content": "It yields awaitables as they finish, so you can process results in completion order rather than input order:\n\n```python\nimport asyncio\n\nasync def work(n):\n    await asyncio.sleep(n)\n    return n\n\nasync def main():\n    coros = [work(3), work(1), work(2)]\n    for fut in asyncio.as_completed(coros):\n        result = await fut\n        print(\"finished\", result)\n\nasyncio.run(main())\n```"}]}
{"messages": [{"role": "user", "content": "How do I cancel an asyncio task?"}, {"role": "silicat", "content": "```python\nimport asyncio\n\nasync def long_task():\n    try:\n        await asyncio.sleep(100)\n    except asyncio.CancelledError:\n        print(\"cancelled, cleaning up\")\n        raise\n\nasync def main():\n    task = asyncio.create_task(long_task())\n    await asyncio.sleep(1)\n    task.cancel()\n    try:\n        await task\n    except asyncio.CancelledError:\n        print(\"task was cancelled\")\n\nasyncio.run(main())\n```"}]}
{"messages": [{"role": "user", "content": "Show me asyncio.TaskGroup from Python 3.11."}, {"role": "silicat", "content": "`TaskGroup` is the modern structured-concurrency way to run tasks; if any task fails, the rest are cancelled:\n\n```python\nimport asyncio\n\nasync def work(n):\n    await asyncio.sleep(n)\n    return n\n\nasync def main():\n    async with asyncio.TaskGroup() as tg:\n        t1 = tg.create_task(work(1))\n        t2 = tg.create_task(work(2))\n    print(t1.result(), t2.result())\n\nasyncio.run(main())\n```"}]}
{"messages": [{"role": "user", "content": "How do I gather but not stop on the first error?"}, {"role": "silicat", "content": "Pass `return_exceptions=True` so exceptions come back as results instead of propagating:\n\n```python\nimport asyncio\n\nasync def maybe_fail(n):\n    if n == 2:\n        raise ValueError(\"boom\")\n    await asyncio.sleep(0.1)\n    return n\n\nasync def main():\n    results = await asyncio.gather(\n        *(maybe_fail(i) for i in range(4)),\n        return_exceptions=True,\n    )\n    print(results)  # [0, 1, ValueError('boom'), 3]\n\nasyncio.run(main())\n```"}]}
{"messages": [{"role": "user", "content": "Run a coroutine periodically every few seconds."}, {"role": "silicat", "content": "```python\nimport asyncio\n\nasync def tick():\n    print(\"tick\")\n\nasync def main():\n    for _ in range(5):\n        await tick()\n        await asyncio.sleep(2)\n\nasyncio.run(main())\n```"}]}
{"messages": [{"role": "user", "content": "What's the difference between a generator and an async generator?"}, {"role": "silicat", "content": "A generator uses `yield` and is iterated with a normal `for`; an async generator uses `yield` inside an `async def` and is iterated with `async for`, allowing `await` between yields.\n\n```python\nimport asyncio\n\ndef sync_gen():\n    for i in range(3):\n        yield i\n\nasync def async_gen():\n    for i in range(3):\n        await asyncio.sleep(0.1)\n        yield i\n\nasync def main():\n    async for x in async_gen():\n        print(x)\n\nlist(sync_gen())\nasyncio.run(main())\n```"}]}
{"messages": [{"role": "user", "content": "Write a simple generator function."}, {"role": "silicat", "content": "```python\ndef countdown(n):\n    while n > 0:\n        yield n\n        n -= 1\n\nfor x in countdown(3):\n    print(x)  # 3, 2, 1\n```"}]}
{"messages": [{"role": "user", "content": "How do I make an async generator?"}, {"role": "silicat", "content": "```python\nimport asyncio\n\nasync def stream_numbers(limit):\n    for i in range(limit):\n        await asyncio.sleep(0.2)\n        yield i\n\nasync def main():\n    async for n in stream_numbers(5):\n        print(n)\n\nasyncio.run(main())\n```"}]}
{"messages": [{"role": "user", "content": "Explain yield in Python."}, {"role": "silicat", "content": "`yield` turns a function into a generator: it produces a value and pauses, resuming where it left off on the next iteration. This makes generators lazy and memory-efficient.\n\n```python\ndef fib():\n    a, b = 0, 1\n    while True:\n        yield a\n        a, b = b, a + b\n\ngen = fib()\nprint([next(gen) for _ in range(6)])  # [0, 1, 1, 2, 3, 5]\n```"}]}
{"messages": [{"role": "user", "content": "How do I collect all items from an async generator into a list?"}, {"role": "silicat", "content": "```python\nimport asyncio\n\nasync def gen():\n    for i in range(5):\n        await asyncio.sleep(0.05)\n        yield i\n\nasync def main():\n    items = [x async for x in gen()]  # async comprehension\n    print(items)\n\nasyncio.run(main())\n```"}]}
