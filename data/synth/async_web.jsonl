{"messages": [{"role": "user", "content": "Create a FastAPI endpoint that returns a list of items."}, {"role": "silicat", "content": "```python\nfrom fastapi import FastAPI\n\napp = FastAPI()\n\n@app.get(\"/items\")\ndef list_items():\n    return [{\"id\": 1, \"name\": \"apple\"}, {\"id\": 2, \"name\": \"banana\"}]\n```"}, {"role": "user", "content": "Add an endpoint to create an item with a Pydantic model."}, {"role": "silicat", "content": "```python\nfrom fastapi import FastAPI\nfrom pydantic import BaseModel\n\napp = FastAPI()\n\nclass Item(BaseModel):\n    name: str\n    price: float\n\n@app.post(\"/items\")\ndef create_item(item: Item):\n    return {\"created\": item.name, \"price\": item.price}\n```"}, {"role": "user", "content": "Return a 404 if an item id isn't found."}, {"role": "silicat", "content": "```python\nfrom fastapi import FastAPI, HTTPException\n\napp = FastAPI()\n\nitems = {1: \"apple\", 2: \"banana\"}\n\n@app.get(\"/items/{item_id}\")\ndef get_item(item_id: int):\n    if item_id not in items:\n        raise HTTPException(status_code=404, detail=\"Item not found\")\n    return {\"id\": item_id, \"name\": items[item_id]}\n```"}]}
{"messages": [{"role": "user", "content": "Show me a producer/consumer with asyncio.Queue."}, {"role": "silicat", "content": "```python\nimport asyncio\n\nasync def producer(q):\n    for i in range(5):\n        await q.put(i)\n    await q.put(None)\n\nasync def consumer(q):\n    while True:\n        item = await q.get()\n        if item is None:\n            break\n        print(\"got\", item)\n\nasync def main():\n    q = asyncio.Queue()\n    await asyncio.gather(producer(q), consumer(q))\n\nasyncio.run(main())\n```"}, {"role": "user", "content": "Use multiple consumers."}, {"role": "silicat", "content": "```python\nimport asyncio\n\nasync def producer(q, n):\n    for i in range(n):\n        await q.put(i)\n\nasync def consumer(q, name):\n    while True:\n        item = await q.get()\n        print(f\"{name} got {item}\")\n        q.task_done()\n\nasync def main():\n    q = asyncio.Queue()\n    consumers = [asyncio.create_task(consumer(q, f\"c{i}\")) for i in range(3)]\n    await producer(q, 10)\n    await q.join()          # wait until all items processed\n    for c in consumers:\n        c.cancel()\n\nasyncio.run(main())\n```"}]}
{"messages": [{"role": "user", "content": "How do I do a GET with aiohttp?"}, {"role": "silicat", "content": "```python\nimport aiohttp\nimport asyncio\n\nasync def fetch(url):\n    async with aiohttp.ClientSession() as session:\n        async with session.get(url) as resp:\n            return await resp.text()\n\nprint(asyncio.run(fetch(\"https://example.com\"))[:100])\n```"}, {"role": "user", "content": "Now fetch a list of URLs concurrently with one session."}, {"role": "silicat", "content": "```python\nimport aiohttp\nimport asyncio\n\nasync def fetch(session, url):\n    async with session.get(url) as resp:\n        return await resp.text()\n\nasync def main(urls):\n    async with aiohttp.ClientSession() as session:\n        return await asyncio.gather(*(fetch(session, u) for u in urls))\n\nurls = [\"https://example.com\"] * 5\nresults = asyncio.run(main(urls))\nprint(len(results))\n```"}, {"role": "user", "content": "Cap it at 5 concurrent requests and handle errors."}, {"role": "silicat", "content": "```python\nimport aiohttp\nimport asyncio\n\nasync def fetch(session, sem, url):\n    async with sem:\n        try:\n            async with session.get(url, timeout=aiohttp.ClientTimeout(total=10)) as resp:\n                resp.raise_for_status()\n                return await resp.text()\n        except (aiohttp.ClientError, asyncio.TimeoutError) as e:\n            return f\"error: {e}\"\n\nasync def main(urls):\n    sem = asyncio.Semaphore(5)\n    async with aiohttp.ClientSession() as session:\n        return await asyncio.gather(*(fetch(session, sem, u) for u in urls))\n\nurls = [\"https://example.com\"] * 20\nasyncio.run(main(urls))\n```"}]}
{"messages": [{"role": "user", "content": "I have a CPU-heavy function. How do I speed it up with threads?"}, {"role": "silicat", "content": "Threads won't help CPU-bound work because of the GIL. Use multiprocessing instead:\n\n```python\nfrom concurrent.futures import ProcessPoolExecutor\n\ndef crunch(n):\n    return sum(i * i for i in range(n))\n\nif __name__ == \"__main__\":\n    with ProcessPoolExecutor() as ex:\n        results = list(ex.map(crunch, [5_000_000] * 4))\n    print(results)\n```"}, {"role": "user", "content": "Why exactly don't threads help here?"}, {"role": "silicat", "content": "The CPython GIL allows only one thread to execute Python bytecode at a time, so CPU-bound threads just take turns rather than running in parallel. Multiprocessing spawns separate processes, each with its own interpreter and GIL, so they genuinely run on different cores."}]}
{"messages": [{"role": "user", "content": "Make a requests call and check the status code."}, {"role": "silicat", "content": "```python\nimport requests\n\nresp = requests.get(\"https://example.com\")\nprint(resp.status_code)\n```"}, {"role": "user", "content": "Raise an exception on a bad status."}, {"role": "silicat", "content": "```python\nimport requests\n\nresp = requests.get(\"https://example.com\")\nresp.raise_for_status()  # raises HTTPError on 4xx/5xx\nprint(\"ok\")\n```"}, {"role": "user", "content": "Wrap it so it retries 3 times."}, {"role": "silicat", "content": "```python\nimport requests\nimport time\n\ndef get_with_retry(url, retries=3, delay=1):\n    for attempt in range(retries):\n        try:\n            resp = requests.get(url, timeout=5)\n            resp.raise_for_status()\n            return resp\n        except requests.exceptions.RequestException as e:\n            if attempt == retries - 1:\n                raise\n            time.sleep(delay)\n\nresp = get_with_retry(\"https://example.com\")\nprint(resp.status_code)\n```"}]}
{"messages": [{"role": "user", "content": "Convert a blocking loop of requests into asyncio."}, {"role": "silicat", "content": "Since `requests` is blocking, run it in threads via `asyncio.to_thread`:\n\n```python\nimport asyncio\nimport requests\n\ndef fetch(url):\n    return requests.get(url, timeout=5).status_code\n\nasync def main(urls):\n    tasks = [asyncio.to_thread(fetch, u) for u in urls]\n    return await asyncio.gather(*tasks)\n\nurls = [\"https://example.com\"] * 5\nprint(asyncio.run(main(urls)))\n```"}, {"role": "user", "content": "Can I do it natively async instead of using threads?"}, {"role": "silicat", "content": "Yes, switch to `aiohttp` which is natively async:\n\n```python\nimport aiohttp\nimport asyncio\n\nasync def fetch(session, url):\n    async with session.get(url) as resp:\n        return resp.status\n\nasync def main(urls):\n    async with aiohttp.ClientSession() as session:\n        return await asyncio.gather(*(fetch(session, u) for u in urls))\n\nurls = [\"https://example.com\"] * 5\nprint(asyncio.run(main(urls)))\n```"}]}
{"messages": [{"role": "user", "content": "Write an asyncio task that runs in the background."}, {"role": "silicat", "content": "```python\nimport asyncio\n\nasync def background():\n    await asyncio.sleep(2)\n    print(\"done\")\n\nasync def main():\n    task = asyncio.create_task(background())\n    print(\"main continues\")\n    await task\n\nasyncio.run(main())\n```"}, {"role": "user", "content": "How do I cancel it if it takes too long?"}, {"role": "silicat", "content": "```python\nimport asyncio\n\nasync def background():\n    await asyncio.sleep(100)\n\nasync def main():\n    task = asyncio.create_task(background())\n    await asyncio.sleep(2)\n    task.cancel()\n    try:\n        await task\n    except asyncio.CancelledError:\n        print(\"cancelled\")\n\nasyncio.run(main())\n```"}]}
{"messages": [{"role": "user", "content": "Set up a Flask API with a /users endpoint."}, {"role": "silicat", "content": "```python\nfrom flask import Flask, jsonify\n\napp = Flask(__name__)\nusers = [{\"id\": 1, \"name\": \"alice\"}]\n\n@app.route(\"/users\")\ndef list_users():\n    return jsonify(users)\n\nif __name__ == \"__main__\":\n    app.run(debug=True)\n```"}, {"role": "user", "content": "Add a POST to create a user."}, {"role": "silicat", "content": "```python\nfrom flask import Flask, jsonify, request\n\napp = Flask(__name__)\nusers = [{\"id\": 1, \"name\": \"alice\"}]\n\n@app.route(\"/users\", methods=[\"GET\", \"POST\"])\ndef users_route():\n    if request.method == \"POST\":\n        data = request.get_json()\n        new_user = {\"id\": len(users) + 1, \"name\": data[\"name\"]}\n        users.append(new_user)\n        return jsonify(new_user), 201\n    return jsonify(users)\n\nif __name__ == \"__main__\":\n    app.run(debug=True)\n```"}]}
{"messages": [{"role": "user", "content": "How do I read JSON from a public API?"}, {"role": "silicat", "content": "```python\nimport requests\n\nresp = requests.get(\"https://jsonplaceholder.typicode.com/todos/1\")\ndata = resp.json()\nprint(data[\"title\"])\n```"}, {"role": "user", "content": "Now get the first 5 todos and print their titles."}, {"role": "silicat", "content": "```python\nimport requests\n\nresp = requests.get(\"https://jsonplaceholder.typicode.com/todos\")\ntodos = resp.json()[:5]\nfor todo in todos:\n    print(todo[\"title\"])\n```"}]}
{"messages": [{"role": "user", "content": "Show me asyncio.gather with results."}, {"role": "silicat", "content": "```python\nimport asyncio\n\nasync def fetch(n):\n    await asyncio.sleep(0.1)\n    return n * 10\n\nasync def main():\n    return await asyncio.gather(fetch(1), fetch(2), fetch(3))\n\nprint(asyncio.run(main()))  # [10, 20, 30]\n```"}, {"role": "user", "content": "What if one of them raises an exception?"}, {"role": "silicat", "content": "By default `gather` propagates the first exception and the rest keep running but their results are lost. Use `return_exceptions=True` to collect them instead:\n\n```python\nimport asyncio\n\nasync def fetch(n):\n    if n == 2:\n        raise ValueError(\"bad\")\n    return n\n\nasync def main():\n    return await asyncio.gather(fetch(1), fetch(2), fetch(3), return_exceptions=True)\n\nprint(asyncio.run(main()))  # [1, ValueError('bad'), 3]\n```"}]}
{"messages": [{"role": "user", "content": "Make a websocket echo server."}, {"role": "silicat", "content": "```python\nimport asyncio\nimport websockets\n\nasync def echo(websocket):\n    async for msg in websocket:\n        await websocket.send(msg)\n\nasync def main():\n    async with websockets.serve(echo, \"localhost\", 8765):\n        await asyncio.Future()\n\nasyncio.run(main())\n```"}, {"role": "user", "content": "Write a client to test it."}, {"role": "silicat", "content": "```python\nimport asyncio\nimport websockets\n\nasync def test():\n    async with websockets.connect(\"ws://localhost:8765\") as ws:\n        await ws.send(\"ping\")\n        print(await ws.recv())\n\nasyncio.run(test())\n```"}]}
{"messages": [{"role": "user", "content": "How do I use ThreadPoolExecutor.map?"}, {"role": "silicat", "content": "```python\nfrom concurrent.futures import ThreadPoolExecutor\n\ndef double(n):\n    return n * 2\n\nwith ThreadPoolExecutor(max_workers=4) as ex:\n    print(list(ex.map(double, range(5))))\n```"}, {"role": "user", "content": "How do I get results as they complete instead?"}, {"role": "silicat", "content": "Use `submit` + `as_completed`:\n\n```python\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nimport time\n\ndef work(n):\n    time.sleep(n)\n    return n\n\nwith ThreadPoolExecutor(max_workers=3) as ex:\n    futures = [ex.submit(work, n) for n in [3, 1, 2]]\n    for fut in as_completed(futures):\n        print(\"done\", fut.result())\n```"}]}
{"messages": [{"role": "user", "content": "Send a POST request with requests."}, {"role": "silicat", "content": "```python\nimport requests\n\nresp = requests.post(\"https://httpbin.org/post\", json={\"key\": \"value\"})\nprint(resp.json()[\"json\"])\n```"}, {"role": "user", "content": "Add an Authorization header."}, {"role": "silicat", "content": "```python\nimport requests\n\nheaders = {\"Authorization\": \"Bearer my-token\"}\nresp = requests.post(\n    \"https://httpbin.org/post\",\n    json={\"key\": \"value\"},\n    headers=headers,\n)\nprint(resp.json()[\"headers\"][\"Authorization\"])\n```"}, {"role": "user", "content": "Use a session so the header persists across calls."}, {"role": "silicat", "content": "```python\nimport requests\n\nwith requests.Session() as s:\n    s.headers.update({\"Authorization\": \"Bearer my-token\"})\n    r1 = s.post(\"https://httpbin.org/post\", json={\"a\": 1})\n    r2 = s.get(\"https://httpbin.org/get\")\n    print(r1.status_code, r2.status_code)\n```"}]}
{"messages": [{"role": "user", "content": "Write an async generator that yields numbers."}, {"role": "silicat", "content": "```python\nimport asyncio\n\nasync def numbers(n):\n    for i in range(n):\n        await asyncio.sleep(0.1)\n        yield i\n\nasync def main():\n    async for x in numbers(5):\n        print(x)\n\nasyncio.run(main())\n```"}, {"role": "user", "content": "Collect them into a list."}, {"role": "silicat", "content": "```python\nimport asyncio\n\nasync def numbers(n):\n    for i in range(n):\n        await asyncio.sleep(0.1)\n        yield i\n\nasync def main():\n    return [x async for x in numbers(5)]\n\nprint(asyncio.run(main()))  # [0, 1, 2, 3, 4]\n```"}]}
{"messages": [{"role": "user", "content": "Make a basic asyncio program with two tasks."}, {"role": "silicat", "content": "```python\nimport asyncio\n\nasync def task(name):\n    await asyncio.sleep(1)\n    print(name)\n\nasync def main():\n    await asyncio.gather(task(\"a\"), task(\"b\"))\n\nasyncio.run(main())\n```"}, {"role": "user", "content": "Use a TaskGroup instead."}, {"role": "silicat", "content": "```python\nimport asyncio\n\nasync def task(name):\n    await asyncio.sleep(1)\n    print(name)\n\nasync def main():\n    async with asyncio.TaskGroup() as tg:\n        tg.create_task(task(\"a\"))\n        tg.create_task(task(\"b\"))\n\nasyncio.run(main())\n```"}]}
{"messages": [{"role": "user", "content": "How do I call a REST API and handle the JSON?"}, {"role": "silicat", "content": "```python\nimport requests\n\nresp = requests.get(\"https://api.github.com/repos/python/cpython\")\nresp.raise_for_status()\ndata = resp.json()\nprint(data[\"full_name\"], data[\"stargazers_count\"])\n```"}, {"role": "user", "content": "What if the response isn't valid JSON?"}, {"role": "silicat", "content": "Catch `requests.exceptions.JSONDecodeError`:\n\n```python\nimport requests\n\nresp = requests.get(\"https://example.com\")\ntry:\n    data = resp.json()\nexcept requests.exceptions.JSONDecodeError:\n    print(\"not JSON, raw text:\", resp.text[:100])\n```"}]}
{"messages": [{"role": "user", "content": "Create a multiprocessing pool that squares numbers."}, {"role": "silicat", "content": "```python\nimport multiprocessing as mp\n\ndef square(n):\n    return n * n\n\nif __name__ == \"__main__\":\n    with mp.Pool(4) as pool:\n        print(pool.map(square, range(10)))\n```"}, {"role": "user", "content": "Use ProcessPoolExecutor instead."}, {"role": "silicat", "content": "```python\nfrom concurrent.futures import ProcessPoolExecutor\n\ndef square(n):\n    return n * n\n\nif __name__ == \"__main__\":\n    with ProcessPoolExecutor(max_workers=4) as ex:\n        print(list(ex.map(square, range(10))))\n```"}]}
{"messages": [{"role": "user", "content": "How do I rate-limit async requests to N per second?"}, {"role": "silicat", "content": "Combine a semaphore with timed releases, or simplest, gate with a semaphore and sleep:\n\n```python\nimport asyncio\nimport aiohttp\n\nasync def fetch(session, sem, url):\n    async with sem:\n        async with session.get(url) as resp:\n            await asyncio.sleep(1)  # crude pacing\n            return resp.status\n\nasync def main(urls):\n    sem = asyncio.Semaphore(5)\n    async with aiohttp.ClientSession() as session:\n        return await asyncio.gather(*(fetch(session, sem, u) for u in urls))\n\nasyncio.run(main([\"https://example.com\"] * 20))\n```"}, {"role": "user", "content": "That sleeps inside the lock. Can you pace it more cleanly?"}, {"role": "silicat", "content": "Yes, use a token-bucket style with a shared timestamp and lock so the rate is enforced without holding the semaphore during the sleep:\n\n```python\nimport asyncio\nimport time\nimport aiohttp\n\nclass RateLimiter:\n    def __init__(self, rate):\n        self.interval = 1 / rate\n        self.lock = asyncio.Lock()\n        self.next_time = time.monotonic()\n\n    async def wait(self):\n        async with self.lock:\n            now = time.monotonic()\n            if now < self.next_time:\n                await asyncio.sleep(self.next_time - now)\n            self.next_time = max(now, self.next_time) + self.interval\n\nasync def fetch(session, limiter, url):\n    await limiter.wait()\n    async with session.get(url) as resp:\n        return resp.status\n\nasync def main(urls):\n    limiter = RateLimiter(rate=5)  # 5/sec\n    async with aiohttp.ClientSession() as session:\n        return await asyncio.gather(*(fetch(session, limiter, u) for u in urls))\n\nasyncio.run(main([\"https://example.com\"] * 20))\n```"}]}
{"messages": [{"role": "user", "content": "Build a FastAPI app with a query parameter."}, {"role": "silicat", "content": "```python\nfrom fastapi import FastAPI\n\napp = FastAPI()\n\n@app.get(\"/search\")\ndef search(q: str):\n    return {\"query\": q}\n```"}, {"role": "user", "content": "Make the parameter optional with a default."}, {"role": "silicat", "content": "```python\nfrom fastapi import FastAPI\n\napp = FastAPI()\n\n@app.get(\"/search\")\ndef search(q: str = \"\", limit: int = 10):\n    return {\"query\": q, \"limit\": limit}\n```"}, {"role": "user", "content": "Add validation so limit is between 1 and 100."}, {"role": "silicat", "content": "```python\nfrom fastapi import FastAPI, Query\n\napp = FastAPI()\n\n@app.get(\"/search\")\ndef search(q: str = \"\", limit: int = Query(10, ge=1, le=100)):\n    return {\"query\": q, \"limit\": limit}\n```"}]}
{"messages": [{"role": "user", "content": "How do I run blocking code without freezing my asyncio loop?"}, {"role": "silicat", "content": "Offload it with `asyncio.to_thread`:\n\n```python\nimport asyncio\nimport time\n\ndef blocking():\n    time.sleep(3)\n    return \"done\"\n\nasync def main():\n    result = await asyncio.to_thread(blocking)\n    print(result)\n\nasyncio.run(main())\n```"}, {"role": "user", "content": "What about a CPU-bound function instead of sleep?"}, {"role": "silicat", "content": "For CPU-bound work, a thread won't help due to the GIL; run it in a process pool via the loop's executor:\n\n```python\nimport asyncio\nfrom concurrent.futures import ProcessPoolExecutor\n\ndef crunch(n):\n    return sum(i * i for i in range(n))\n\nasync def main():\n    loop = asyncio.get_running_loop()\n    with ProcessPoolExecutor() as pool:\n        result = await loop.run_in_executor(pool, crunch, 10_000_000)\n    print(result)\n\nif __name__ == \"__main__\":\n    asyncio.run(main())\n```"}]}
{"messages": [{"role": "user", "content": "Make an asyncio.Lock example."}, {"role": "silicat", "content": "```python\nimport asyncio\n\nlock = asyncio.Lock()\nbalance = 0\n\nasync def deposit(amount):\n    global balance\n    async with lock:\n        balance += amount\n\nasync def main():\n    await asyncio.gather(*(deposit(10) for _ in range(10)))\n    print(balance)  # 100\n\nasyncio.run(main())\n```"}, {"role": "user", "content": "Why do I even need the lock if asyncio is single-threaded?"}, {"role": "silicat", "content": "Single-threaded doesn't mean atomic: if a coroutine `await`s in the middle of a read-modify-write, another coroutine can interleave and corrupt the shared state. The lock guarantees the critical section runs without interruption from other coroutines."}]}
{"messages": [{"role": "user", "content": "How do I make concurrent requests but keep the GET order in results?"}, {"role": "silicat", "content": "`asyncio.gather` preserves input order in its results:\n\n```python\nimport aiohttp\nimport asyncio\n\nasync def fetch(session, url):\n    async with session.get(url) as resp:\n        return resp.status\n\nasync def main(urls):\n    async with aiohttp.ClientSession() as session:\n        return await asyncio.gather(*(fetch(session, u) for u in urls))\n\nurls = [\"https://example.com/a\", \"https://example.com/b\"]\nprint(asyncio.run(main(urls)))  # order matches urls\n```"}, {"role": "user", "content": "What if I want them in completion order instead?"}, {"role": "silicat", "content": "Use `asyncio.as_completed`:\n\n```python\nimport aiohttp\nimport asyncio\n\nasync def fetch(session, url):\n    async with session.get(url) as resp:\n        return url, resp.status\n\nasync def main(urls):\n    async with aiohttp.ClientSession() as session:\n        coros = [fetch(session, u) for u in urls]\n        for fut in asyncio.as_completed(coros):\n            url, status = await fut\n            print(url, status)\n\nasyncio.run(main([\"https://example.com\"] * 3))\n```"}]}
{"messages": [{"role": "user", "content": "Difference between asyncio.sleep and time.sleep?"}, {"role": "silicat", "content": "`time.sleep()` blocks the entire thread (and event loop), while `asyncio.sleep()` yields control back to the loop so other coroutines can run. In async code always use `asyncio.sleep()`."}]}
