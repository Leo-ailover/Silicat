{"messages": [{"role": "user", "content": "How do I combine threads and a queue for a worker pool manually?"}, {"role": "silicat", "content": "```python\nimport threading\nimport queue\n\nq = queue.Queue()\n\ndef worker():\n    while True:\n        item = q.get()\n        if item is None:\n            break\n        print(\"processed\", item)\n        q.task_done()\n\nthreads = [threading.Thread(target=worker) for _ in range(3)]\nfor t in threads:\n    t.start()\nfor i in range(10):\n    q.put(i)\nq.join()\nfor _ in threads:\n    q.put(None)\nfor t in threads:\n    t.join()\n```"}]}
{"messages": [{"role": "user", "content": "How do I make an async HTTP client reusable as a class?"}, {"role": "silicat", "content": "```python\nimport aiohttp\n\nclass ApiClient:\n    def __init__(self, base_url):\n        self.base_url = base_url\n        self.session = None\n    async def __aenter__(self):\n        self.session = aiohttp.ClientSession()\n        return self\n    async def __aexit__(self, *exc):\n        await self.session.close()\n    async def get(self, path):\n        async with self.session.get(self.base_url + path) as resp:\n            return await resp.json()\n\n# async with ApiClient(\"https://api.github.com\") as client:\n#     data = await client.get(\"/\")\n```"}]}
{"messages": [{"role": "user", "content": "How do I handle SIGINT to stop an asyncio loop with a flag?"}, {"role": "silicat", "content": "```python\nimport asyncio\nimport signal\n\nstop = asyncio.Event()\n\nasync def main():\n    loop = asyncio.get_running_loop()\n    loop.add_signal_handler(signal.SIGINT, stop.set)\n    print(\"running, press Ctrl+C\")\n    await stop.wait()\n    print(\"stopping\")\n\nasyncio.run(main())\n```"}]}
{"messages": [{"role": "user", "content": "How do I measure throughput of concurrent requests?"}, {"role": "silicat", "content": "```python\nimport asyncio\nimport time\nimport aiohttp\n\nasync def fetch(session, url):\n    async with session.get(url) as resp:\n        return resp.status\n\nasync def main(urls):\n    start = time.perf_counter()\n    async with aiohttp.ClientSession() as session:\n        await asyncio.gather(*(fetch(session, u) for u in urls))\n    elapsed = time.perf_counter() - start\n    print(f\"{len(urls)/elapsed:.1f} req/s\")\n\nasyncio.run(main([\"https://example.com\"] * 20))\n```"}]}
