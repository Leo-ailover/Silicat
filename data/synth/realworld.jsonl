{"messages": [{"role": "user", "content": "generate a markdown table from data"}, {"role": "silicat", "content": "```python\ndef to_markdown_table(headers, rows):\n    lines = [\"| \" + \" | \".join(headers) + \" |\",\n             \"| \" + \" | \".join(\"---\" for _ in headers) + \" |\"]\n    for row in rows:\n        lines.append(\"| \" + \" | \".join(str(c) for c in row) + \" |\")\n    return \"\\n\".join(lines)\n```"}]}
{"messages": [{"role": "user", "content": "Write a function to make a progress bar string."}, {"role": "silicat", "content": "```python\ndef progress_bar(current, total, width=30):\n    filled = int(width * current / total)\n    bar = \"#\" * filled + \"-\" * (width - filled)\n    pct = 100 * current / total\n    return f\"[{bar}] {pct:5.1f}%\"\n```"}]}
{"messages": [{"role": "user", "content": "format a number with thousands separators"}, {"role": "silicat", "content": "```python\ndef with_commas(n):\n    return f\"{n:,}\"\n```"}]}
{"messages": [{"role": "user", "content": "format bytes as a human readable size"}, {"role": "silicat", "content": "```python\ndef human_size(num):\n    for unit in [\"B\", \"KB\", \"MB\", \"GB\", \"TB\"]:\n        if abs(num) < 1024:\n            return f\"{num:.1f} {unit}\"\n        num /= 1024\n    return f\"{num:.1f} PB\"\n```"}]}
{"messages": [{"role": "user", "content": "Write a function to format seconds as HH:MM:SS."}, {"role": "silicat", "content": "```python\ndef format_duration(seconds):\n    h, rem = divmod(int(seconds), 3600)\n    m, s = divmod(rem, 60)\n    return f\"{h:02d}:{m:02d}:{s:02d}\"\n```"}]}
{"messages": [{"role": "user", "content": "group a list of dicts by a key"}, {"role": "silicat", "content": "```python\nfrom collections import defaultdict\n\n\ndef group_by(items, key):\n    groups = defaultdict(list)\n    for item in items:\n        groups[item[key]].append(item)\n    return dict(groups)\n```"}]}
{"messages": [{"role": "user", "content": "Write a function to chunk a list into groups of n."}, {"role": "silicat", "content": "```python\ndef chunk(items, n):\n    return [items[i:i + n] for i in range(0, len(items), n)]\n```"}]}
{"messages": [{"role": "user", "content": "flatten a list of lists"}, {"role": "silicat", "content": "```python\ndef flatten(nested):\n    return [x for sub in nested for x in sub]\n```"}]}
{"messages": [{"role": "user", "content": "remove duplicates from a list while preserving order"}, {"role": "silicat", "content": "```python\ndef dedupe(items):\n    seen = set()\n    return [x for x in items if not (x in seen or seen.add(x))]\n```"}]}
{"messages": [{"role": "user", "content": "Write a function to find the intersection of two lists."}, {"role": "silicat", "content": "```python\ndef intersection(a, b):\n    return list(set(a) & set(b))\n```"}]}
{"messages": [{"role": "user", "content": "count items in a list"}, {"role": "silicat", "content": "```python\nfrom collections import Counter\n\n\ndef counts(items):\n    return Counter(items)\n```"}]}
{"messages": [{"role": "user", "content": "invert a dictionary"}, {"role": "silicat", "content": "```python\ndef invert(d):\n    return {v: k for k, v in d.items()}\n```"}]}
{"messages": [{"role": "user", "content": "Write a function to sort a dict by its values."}, {"role": "silicat", "content": "```python\ndef sort_by_value(d, reverse=False):\n    return dict(sorted(d.items(), key=lambda kv: kv[1], reverse=reverse))\n```"}]}
{"messages": [{"role": "user", "content": "merge a list of dicts into one"}, {"role": "silicat", "content": "```python\ndef merge_dicts(dicts):\n    result = {}\n    for d in dicts:\n        result.update(d)\n    return result\n```"}]}
{"messages": [{"role": "user", "content": "find the top 3 most common elements in a list"}, {"role": "silicat", "content": "```python\nfrom collections import Counter\n\n\ndef top_three(items):\n    return Counter(items).most_common(3)\n```"}]}
{"messages": [{"role": "user", "content": "Write a simple todo list in Python that I can add items to."}, {"role": "silicat", "content": "```python\ntodos = []\n\n\ndef add_todo(item):\n    todos.append(item)\n\n\ndef show_todos():\n    for i, item in enumerate(todos, 1):\n        print(f\"{i}. {item}\")\n```"}, {"role": "user", "content": "Add a way to remove an item by its number."}, {"role": "silicat", "content": "```python\ntodos = []\n\n\ndef add_todo(item):\n    todos.append(item)\n\n\ndef remove_todo(number):\n    if 1 <= number <= len(todos):\n        todos.pop(number - 1)\n\n\ndef show_todos():\n    for i, item in enumerate(todos, 1):\n        print(f\"{i}. {item}\")\n```"}, {"role": "user", "content": "Now let me mark items as done instead of just plain strings."}, {"role": "silicat", "content": "Store each item as a dict with a `done` flag.\n\n```python\ntodos = []\n\n\ndef add_todo(item):\n    todos.append({\"text\": item, \"done\": False})\n\n\ndef remove_todo(number):\n    if 1 <= number <= len(todos):\n        todos.pop(number - 1)\n\n\ndef mark_done(number):\n    if 1 <= number <= len(todos):\n        todos[number - 1][\"done\"] = True\n\n\ndef show_todos():\n    for i, item in enumerate(todos, 1):\n        mark = \"x\" if item[\"done\"] else \" \"\n        print(f\"{i}. [{mark}] {item['text']}\")\n```"}, {"role": "user", "content": "Save the list to a JSON file."}, {"role": "silicat", "content": "```python\nimport json\n\ntodos = []\n\n\ndef add_todo(item):\n    todos.append({\"text\": item, \"done\": False})\n\n\ndef remove_todo(number):\n    if 1 <= number <= len(todos):\n        todos.pop(number - 1)\n\n\ndef mark_done(number):\n    if 1 <= number <= len(todos):\n        todos[number - 1][\"done\"] = True\n\n\ndef show_todos():\n    for i, item in enumerate(todos, 1):\n        mark = \"x\" if item[\"done\"] else \" \"\n        print(f\"{i}. [{mark}] {item['text']}\")\n\n\ndef save(path=\"todos.json\"):\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        json.dump(todos, f, indent=2)\n```"}, {"role": "user", "content": "And load it back when the program starts."}, {"role": "silicat", "content": "```python\nimport json\nimport os\n\ntodos = []\n\n\ndef load(path=\"todos.json\"):\n    global todos\n    if os.path.exists(path):\n        with open(path, \"r\", encoding=\"utf-8\") as f:\n            todos = json.load(f)\n\n\ndef add_todo(item):\n    todos.append({\"text\": item, \"done\": False})\n\n\ndef remove_todo(number):\n    if 1 <= number <= len(todos):\n        todos.pop(number - 1)\n\n\ndef mark_done(number):\n    if 1 <= number <= len(todos):\n        todos[number - 1][\"done\"] = True\n\n\ndef show_todos():\n    for i, item in enumerate(todos, 1):\n        mark = \"x\" if item[\"done\"] else \" \"\n        print(f\"{i}. [{mark}] {item['text']}\")\n\n\ndef save(path=\"todos.json\"):\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        json.dump(todos, f, indent=2)\n\n\nif __name__ == \"__main__\":\n    load()\n    # ... interact ...\n    save()\n```\nCalling `load()` at startup repopulates `todos`, and `save()` before exit persists changes."}]}
{"messages": [{"role": "user", "content": "Write a function that counts words in a file."}, {"role": "silicat", "content": "```python\ndef count_words(path):\n    with open(path, encoding=\"utf-8\") as f:\n        return len(f.read().split())\n```"}, {"role": "user", "content": "Make it return the count of each unique word too."}, {"role": "silicat", "content": "```python\nfrom collections import Counter\n\n\ndef count_words(path):\n    with open(path, encoding=\"utf-8\") as f:\n        words = f.read().lower().split()\n    return Counter(words)\n```"}, {"role": "user", "content": "Strip punctuation so 'word.' and 'word' count as the same."}, {"role": "silicat", "content": "```python\nimport string\nfrom collections import Counter\n\n\ndef count_words(path):\n    with open(path, encoding=\"utf-8\") as f:\n        text = f.read().lower()\n    text = text.translate(str.maketrans(\"\", \"\", string.punctuation))\n    return Counter(text.split())\n```"}, {"role": "user", "content": "Print the top 10 words."}, {"role": "silicat", "content": "```python\nimport string\nfrom collections import Counter\n\n\ndef count_words(path):\n    with open(path, encoding=\"utf-8\") as f:\n        text = f.read().lower()\n    text = text.translate(str.maketrans(\"\", \"\", string.punctuation))\n    return Counter(text.split())\n\n\ndef print_top(path, n=10):\n    for word, count in count_words(path).most_common(n):\n        print(f\"{count:>5}  {word}\")\n```"}]}
{"messages": [{"role": "user", "content": "I want a CLI tool to convert a CSV file to JSON."}, {"role": "silicat", "content": "```python\nimport argparse\nimport csv\nimport json\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"csv_file\")\n    parser.add_argument(\"json_file\")\n    args = parser.parse_args()\n    with open(args.csv_file, newline=\"\", encoding=\"utf-8\") as f:\n        rows = list(csv.DictReader(f))\n    with open(args.json_file, \"w\", encoding=\"utf-8\") as f:\n        json.dump(rows, f, indent=2)\n\n\nif __name__ == \"__main__\":\n    main()\n```"}, {"role": "user", "content": "Make the output file optional and print to stdout if not given."}, {"role": "silicat", "content": "```python\nimport argparse\nimport csv\nimport json\nimport sys\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"csv_file\")\n    parser.add_argument(\"json_file\", nargs=\"?\")\n    args = parser.parse_args()\n    with open(args.csv_file, newline=\"\", encoding=\"utf-8\") as f:\n        rows = list(csv.DictReader(f))\n    text = json.dumps(rows, indent=2)\n    if args.json_file:\n        with open(args.json_file, \"w\", encoding=\"utf-8\") as f:\n            f.write(text)\n    else:\n        sys.stdout.write(text + \"\\n\")\n\n\nif __name__ == \"__main__\":\n    main()\n```"}, {"role": "user", "content": "Add a --delimiter option for the CSV."}, {"role": "silicat", "content": "```python\nimport argparse\nimport csv\nimport json\nimport sys\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"csv_file\")\n    parser.add_argument(\"json_file\", nargs=\"?\")\n    parser.add_argument(\"--delimiter\", default=\",\")\n    args = parser.parse_args()\n    with open(args.csv_file, newline=\"\", encoding=\"utf-8\") as f:\n        rows = list(csv.DictReader(f, delimiter=args.delimiter))\n    text = json.dumps(rows, indent=2)\n    if args.json_file:\n        with open(args.json_file, \"w\", encoding=\"utf-8\") as f:\n            f.write(text)\n    else:\n        sys.stdout.write(text + \"\\n\")\n\n\nif __name__ == \"__main__\":\n    main()\n```"}]}
{"messages": [{"role": "user", "content": "Write a function to generate a random password."}, {"role": "silicat", "content": "```python\nimport secrets\nimport string\n\n\ndef generate(length=12):\n    chars = string.ascii_letters + string.digits\n    return \"\".join(secrets.choice(chars) for _ in range(length))\n```"}, {"role": "user", "content": "Let me include symbols optionally."}, {"role": "silicat", "content": "```python\nimport secrets\nimport string\n\n\ndef generate(length=12, symbols=False):\n    chars = string.ascii_letters + string.digits\n    if symbols:\n        chars += string.punctuation\n    return \"\".join(secrets.choice(chars) for _ in range(length))\n```"}, {"role": "user", "content": "Guarantee at least one digit and one uppercase letter."}, {"role": "silicat", "content": "```python\nimport secrets\nimport string\n\n\ndef generate(length=12, symbols=False):\n    chars = string.ascii_letters + string.digits\n    if symbols:\n        chars += string.punctuation\n    while True:\n        pw = \"\".join(secrets.choice(chars) for _ in range(length))\n        if any(c.isdigit() for c in pw) and any(c.isupper() for c in pw):\n            return pw\n```\nRe-rolling until the constraints are met keeps the distribution uniform and the code simple."}, {"role": "user", "content": "Turn it into a command line tool."}, {"role": "silicat", "content": "```python\nimport argparse\nimport secrets\nimport string\n\n\ndef generate(length=12, symbols=False):\n    chars = string.ascii_letters + string.digits\n    if symbols:\n        chars += string.punctuation\n    while True:\n        pw = \"\".join(secrets.choice(chars) for _ in range(length))\n        if any(c.isdigit() for c in pw) and any(c.isupper() for c in pw):\n            return pw\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"-l\", \"--length\", type=int, default=12)\n    parser.add_argument(\"-s\", \"--symbols\", action=\"store_true\")\n    args = parser.parse_args()\n    print(generate(args.length, args.symbols))\n\n\nif __name__ == \"__main__\":\n    main()\n```"}]}
{"messages": [{"role": "user", "content": "Help me read a log file and find error lines."}, {"role": "silicat", "content": "```python\ndef find_errors(path):\n    with open(path, encoding=\"utf-8\") as f:\n        return [line.rstrip() for line in f if \"ERROR\" in line]\n```"}, {"role": "user", "content": "Count how many errors there are per day. The lines start with a date like 2024-01-15."}, {"role": "silicat", "content": "```python\nfrom collections import Counter\n\n\ndef errors_per_day(path):\n    counts = Counter()\n    with open(path, encoding=\"utf-8\") as f:\n        for line in f:\n            if \"ERROR\" in line:\n                date = line[:10]\n                counts[date] += 1\n    return counts\n```"}, {"role": "user", "content": "Write the summary to a CSV file."}, {"role": "silicat", "content": "```python\nimport csv\nfrom collections import Counter\n\n\ndef errors_per_day(path):\n    counts = Counter()\n    with open(path, encoding=\"utf-8\") as f:\n        for line in f:\n            if \"ERROR\" in line:\n                counts[line[:10]] += 1\n    return counts\n\n\ndef write_summary(log_path, out_path):\n    counts = errors_per_day(log_path)\n    with open(out_path, \"w\", newline=\"\", encoding=\"utf-8\") as f:\n        writer = csv.writer(f)\n        writer.writerow([\"date\", \"error_count\"])\n        for date in sorted(counts):\n            writer.writerow([date, counts[date]])\n```"}]}
{"messages": [{"role": "user", "content": "Write a contact book that stores name and phone in a dict."}, {"role": "silicat", "content": "```python\ncontacts = {}\n\n\ndef add_contact(name, phone):\n    contacts[name] = phone\n\n\ndef get_contact(name):\n    return contacts.get(name)\n```"}, {"role": "user", "content": "Persist it to a JSON file."}, {"role": "silicat", "content": "```python\nimport json\n\ncontacts = {}\n\n\ndef add_contact(name, phone):\n    contacts[name] = phone\n\n\ndef get_contact(name):\n    return contacts.get(name)\n\n\ndef save(path=\"contacts.json\"):\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        json.dump(contacts, f, indent=2)\n```"}, {"role": "user", "content": "Load existing contacts on startup."}, {"role": "silicat", "content": "```python\nimport json\nimport os\n\ncontacts = {}\n\n\ndef load(path=\"contacts.json\"):\n    global contacts\n    if os.path.exists(path):\n        with open(path, encoding=\"utf-8\") as f:\n            contacts = json.load(f)\n\n\ndef add_contact(name, phone):\n    contacts[name] = phone\n\n\ndef get_contact(name):\n    return contacts.get(name)\n\n\ndef save(path=\"contacts.json\"):\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        json.dump(contacts, f, indent=2)\n```"}, {"role": "user", "content": "Add search by partial name match."}, {"role": "silicat", "content": "```python\nimport json\nimport os\n\ncontacts = {}\n\n\ndef load(path=\"contacts.json\"):\n    global contacts\n    if os.path.exists(path):\n        with open(path, encoding=\"utf-8\") as f:\n            contacts = json.load(f)\n\n\ndef add_contact(name, phone):\n    contacts[name] = phone\n\n\ndef get_contact(name):\n    return contacts.get(name)\n\n\ndef search(query):\n    q = query.lower()\n    return {name: phone for name, phone in contacts.items() if q in name.lower()}\n\n\ndef save(path=\"contacts.json\"):\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        json.dump(contacts, f, indent=2)\n```"}]}
{"messages": [{"role": "user", "content": "Write something to rename all the files in a folder."}, {"role": "silicat", "content": "What renaming do you want? Here's a starting point that lowercases every filename:\n\n```python\nfrom pathlib import Path\n\n\ndef rename_all(directory):\n    for f in Path(directory).iterdir():\n        if f.is_file():\n            f.rename(f.with_name(f.name.lower()))\n```"}, {"role": "user", "content": "Actually I want to add the file's modification date as a prefix."}, {"role": "silicat", "content": "```python\nfrom datetime import datetime\nfrom pathlib import Path\n\n\ndef prefix_with_date(directory):\n    for f in Path(directory).iterdir():\n        if f.is_file():\n            mtime = datetime.fromtimestamp(f.stat().st_mtime)\n            prefix = mtime.strftime(\"%Y-%m-%d_\")\n            f.rename(f.with_name(prefix + f.name))\n```"}, {"role": "user", "content": "Do a dry run first that just prints what it would do."}, {"role": "silicat", "content": "```python\nfrom datetime import datetime\nfrom pathlib import Path\n\n\ndef prefix_with_date(directory, dry_run=False):\n    for f in Path(directory).iterdir():\n        if f.is_file():\n            mtime = datetime.fromtimestamp(f.stat().st_mtime)\n            new_name = mtime.strftime(\"%Y-%m-%d_\") + f.name\n            if dry_run:\n                print(f\"{f.name} -> {new_name}\")\n            else:\n                f.rename(f.with_name(new_name))\n```"}]}
{"messages": [{"role": "user", "content": "Make a function to fetch JSON from a URL."}, {"role": "silicat", "content": "```python\nimport requests\n\n\ndef fetch(url):\n    resp = requests.get(url, timeout=10)\n    resp.raise_for_status()\n    return resp.json()\n```"}, {"role": "user", "content": "Add retries if it fails."}, {"role": "silicat", "content": "```python\nimport time\n\nimport requests\n\n\ndef fetch(url, retries=3):\n    for attempt in range(retries):\n        try:\n            resp = requests.get(url, timeout=10)\n            resp.raise_for_status()\n            return resp.json()\n        except requests.RequestException:\n            if attempt == retries - 1:\n                raise\n            time.sleep(2 ** attempt)\n```"}, {"role": "user", "content": "Cache the result to disk so repeated calls don't hit the network."}, {"role": "silicat", "content": "```python\nimport hashlib\nimport json\nimport time\nfrom pathlib import Path\n\nimport requests\n\nCACHE_DIR = Path(\".cache\")\n\n\ndef fetch(url, retries=3):\n    CACHE_DIR.mkdir(exist_ok=True)\n    key = hashlib.md5(url.encode()).hexdigest()\n    cache_file = CACHE_DIR / f\"{key}.json\"\n    if cache_file.exists():\n        return json.loads(cache_file.read_text(encoding=\"utf-8\"))\n    for attempt in range(retries):\n        try:\n            resp = requests.get(url, timeout=10)\n            resp.raise_for_status()\n            data = resp.json()\n            cache_file.write_text(json.dumps(data), encoding=\"utf-8\")\n            return data\n        except requests.RequestException:\n            if attempt == retries - 1:\n                raise\n            time.sleep(2 ** attempt)\n```"}]}
{"messages": [{"role": "user", "content": "Write a temperature converter function."}, {"role": "silicat", "content": "```python\ndef c_to_f(c):\n    return c * 9 / 5 + 32\n```"}, {"role": "user", "content": "Add fahrenheit to celsius and kelvin too."}, {"role": "silicat", "content": "```python\ndef c_to_f(c):\n    return c * 9 / 5 + 32\n\n\ndef f_to_c(f):\n    return (f - 32) * 5 / 9\n\n\ndef c_to_k(c):\n    return c + 273.15\n\n\ndef k_to_c(k):\n    return k - 273.15\n```"}, {"role": "user", "content": "Wrap it in an interactive command line menu."}, {"role": "silicat", "content": "```python\ndef c_to_f(c):\n    return c * 9 / 5 + 32\n\n\ndef f_to_c(f):\n    return (f - 32) * 5 / 9\n\n\ndef c_to_k(c):\n    return c + 273.15\n\n\ndef k_to_c(k):\n    return k - 273.15\n\n\nCONVERSIONS = {\n    \"1\": (\"C to F\", c_to_f),\n    \"2\": (\"F to C\", f_to_c),\n    \"3\": (\"C to K\", c_to_k),\n    \"4\": (\"K to C\", k_to_c),\n}\n\n\ndef main():\n    while True:\n        for key, (label, _) in CONVERSIONS.items():\n            print(f\"{key}. {label}\")\n        choice = input(\"Choose (q to quit): \").strip()\n        if choice == \"q\":\n            break\n        if choice in CONVERSIONS:\n            value = float(input(\"Value: \"))\n            print(round(CONVERSIONS[choice][1](value), 2))\n\n\nif __name__ == \"__main__\":\n    main()\n```"}]}
{"messages": [{"role": "user", "content": "I need to read a CSV of sales and total the revenue."}, {"role": "silicat", "content": "```python\nimport csv\n\n\ndef total_revenue(path):\n    with open(path, newline=\"\", encoding=\"utf-8\") as f:\n        return sum(float(row[\"amount\"]) for row in csv.DictReader(f))\n```"}, {"role": "user", "content": "Break it down by region."}, {"role": "silicat", "content": "```python\nimport csv\nfrom collections import defaultdict\n\n\ndef revenue_by_region(path):\n    totals = defaultdict(float)\n    with open(path, newline=\"\", encoding=\"utf-8\") as f:\n        for row in csv.DictReader(f):\n            totals[row[\"region\"]] += float(row[\"amount\"])\n    return dict(totals)\n```"}, {"role": "user", "content": "Print it sorted from highest to lowest."}, {"role": "silicat", "content": "```python\nimport csv\nfrom collections import defaultdict\n\n\ndef revenue_by_region(path):\n    totals = defaultdict(float)\n    with open(path, newline=\"\", encoding=\"utf-8\") as f:\n        for row in csv.DictReader(f):\n            totals[row[\"region\"]] += float(row[\"amount\"])\n    return dict(totals)\n\n\ndef report(path):\n    totals = revenue_by_region(path)\n    for region, amount in sorted(totals.items(), key=lambda kv: kv[1], reverse=True):\n        print(f\"{region:<15} {amount:>12,.2f}\")\n```"}]}
{"messages": [{"role": "user", "content": "Write a script that backs up a file by copying it with a timestamp."}, {"role": "silicat", "content": "```python\nimport shutil\nfrom datetime import datetime\nfrom pathlib import Path\n\n\ndef backup(path):\n    src = Path(path)\n    stamp = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n    dst = src.with_name(f\"{src.stem}_{stamp}{src.suffix}\")\n    shutil.copy2(src, dst)\n    return dst\n```"}, {"role": "user", "content": "Put backups in a 'backups' subfolder instead."}, {"role": "silicat", "content": "```python\nimport shutil\nfrom datetime import datetime\nfrom pathlib import Path\n\n\ndef backup(path):\n    src = Path(path)\n    backup_dir = src.parent / \"backups\"\n    backup_dir.mkdir(exist_ok=True)\n    stamp = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n    dst = backup_dir / f\"{src.stem}_{stamp}{src.suffix}\"\n    shutil.copy2(src, dst)\n    return dst\n```"}, {"role": "user", "content": "Only keep the 5 most recent backups."}, {"role": "silicat", "content": "```python\nimport shutil\nfrom datetime import datetime\nfrom pathlib import Path\n\n\ndef backup(path, keep=5):\n    src = Path(path)\n    backup_dir = src.parent / \"backups\"\n    backup_dir.mkdir(exist_ok=True)\n    stamp = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n    dst = backup_dir / f\"{src.stem}_{stamp}{src.suffix}\"\n    shutil.copy2(src, dst)\n\n    backups = sorted(\n        backup_dir.glob(f\"{src.stem}_*{src.suffix}\"),\n        key=lambda p: p.stat().st_mtime,\n        reverse=True,\n    )\n    for old in backups[keep:]:\n        old.unlink()\n    return dst\n```"}]}
{"messages": [{"role": "user", "content": "Write a function to validate an email."}, {"role": "silicat", "content": "```python\nimport re\n\nEMAIL_RE = re.compile(r\"^[\\w.+-]+@[\\w-]+\\.[\\w.-]+$\")\n\n\ndef is_valid_email(email):\n    return bool(EMAIL_RE.match(email))\n```"}, {"role": "user", "content": "Read a file of emails, one per line, and split valid from invalid."}, {"role": "silicat", "content": "```python\nimport re\n\nEMAIL_RE = re.compile(r\"^[\\w.+-]+@[\\w-]+\\.[\\w.-]+$\")\n\n\ndef is_valid_email(email):\n    return bool(EMAIL_RE.match(email))\n\n\ndef validate_file(path):\n    valid, invalid = [], []\n    with open(path, encoding=\"utf-8\") as f:\n        for line in f:\n            email = line.strip()\n            if not email:\n                continue\n            (valid if is_valid_email(email) else invalid).append(email)\n    return valid, invalid\n```"}, {"role": "user", "content": "Write the valid ones to valid.txt and invalid to invalid.txt."}, {"role": "silicat", "content": "```python\nimport re\n\nEMAIL_RE = re.compile(r\"^[\\w.+-]+@[\\w-]+\\.[\\w.-]+$\")\n\n\ndef is_valid_email(email):\n    return bool(EMAIL_RE.match(email))\n\n\ndef validate_file(path):\n    valid, invalid = [], []\n    with open(path, encoding=\"utf-8\") as f:\n        for line in f:\n            email = line.strip()\n            if not email:\n                continue\n            (valid if is_valid_email(email) else invalid).append(email)\n    return valid, invalid\n\n\ndef write_results(path):\n    valid, invalid = validate_file(path)\n    with open(\"valid.txt\", \"w\", encoding=\"utf-8\") as f:\n        f.write(\"\\n\".join(valid) + \"\\n\")\n    with open(\"invalid.txt\", \"w\", encoding=\"utf-8\") as f:\n        f.write(\"\\n\".join(invalid) + \"\\n\")\n```"}]}
{"messages": [{"role": "user", "content": "Make a stopwatch I can start and stop."}, {"role": "silicat", "content": "```python\nimport time\n\n\nclass Stopwatch:\n    def __init__(self):\n        self._start = None\n\n    def start(self):\n        self._start = time.perf_counter()\n\n    def stop(self):\n        return time.perf_counter() - self._start\n```"}, {"role": "user", "content": "Make it usable as a context manager."}, {"role": "silicat", "content": "```python\nimport time\n\n\nclass Stopwatch:\n    def __enter__(self):\n        self._start = time.perf_counter()\n        return self\n\n    def __exit__(self, *exc):\n        self.elapsed = time.perf_counter() - self._start\n```\n\n```python\nwith Stopwatch() as sw:\n    do_work()\nprint(sw.elapsed)\n```"}]}
{"messages": [{"role": "user", "content": "Write a word frequency counter for a text file."}, {"role": "silicat", "content": "```python\nfrom collections import Counter\n\n\ndef word_freq(path):\n    with open(path, encoding=\"utf-8\") as f:\n        return Counter(f.read().lower().split())\n```"}, {"role": "user", "content": "Ignore common stop words like 'the', 'a', 'and'."}, {"role": "silicat", "content": "```python\nfrom collections import Counter\n\nSTOP_WORDS = {\"the\", \"a\", \"an\", \"and\", \"or\", \"of\", \"to\", \"in\", \"is\", \"it\"}\n\n\ndef word_freq(path):\n    with open(path, encoding=\"utf-8\") as f:\n        words = f.read().lower().split()\n    return Counter(w for w in words if w not in STOP_WORDS)\n```"}, {"role": "user", "content": "Export the top 20 to a CSV."}, {"role": "silicat", "content": "```python\nimport csv\nfrom collections import Counter\n\nSTOP_WORDS = {\"the\", \"a\", \"an\", \"and\", \"or\", \"of\", \"to\", \"in\", \"is\", \"it\"}\n\n\ndef word_freq(path):\n    with open(path, encoding=\"utf-8\") as f:\n        words = f.read().lower().split()\n    return Counter(w for w in words if w not in STOP_WORDS)\n\n\ndef export_top(text_path, csv_path, n=20):\n    freq = word_freq(text_path)\n    with open(csv_path, \"w\", newline=\"\", encoding=\"utf-8\") as f:\n        writer = csv.writer(f)\n        writer.writerow([\"word\", \"count\"])\n        writer.writerows(freq.most_common(n))\n```"}]}
