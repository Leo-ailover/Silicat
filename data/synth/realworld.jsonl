{"messages": [{"role": "user", "content": "write a simple ROT-N cipher"}, {"role": "silicat", "content": "```python\ndef rotn(text, n):\n    result = []\n    for c in text:\n        if c.isalpha():\n            base = ord(\"A\") if c.isupper() else ord(\"a\")\n            result.append(chr((ord(c) - base + n) % 26 + base))\n        else:\n            result.append(c)\n    return \"\".join(result)\n```"}]}
{"messages": [{"role": "user", "content": "Write a function to summarize a numeric CSV column with count, min, max, mean."}, {"role": "silicat", "content": "```python\nimport csv\n\n\ndef summarize_column(path, column):\n    values = []\n    with open(path, newline=\"\", encoding=\"utf-8\") as f:\n        for row in csv.DictReader(f):\n            try:\n                values.append(float(row[column]))\n            except ValueError:\n                pass\n    return {\n        \"count\": len(values),\n        \"min\": min(values) if values else None,\n        \"max\": max(values) if values else None,\n        \"mean\": sum(values) / len(values) if values else None,\n    }\n```"}]}
{"messages": [{"role": "user", "content": "count the number of times a word appears, whole-word only"}, {"role": "silicat", "content": "```python\nimport re\n\n\ndef whole_word_count(text, word):\n    return len(re.findall(rf\"\\b{re.escape(word)}\\b\", text, re.IGNORECASE))\n```"}]}
