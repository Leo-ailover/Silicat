{"messages": [{"role": "user", "content": "limit how often a function can be called using a decorator"}, {"role": "silicat", "content": "```python\nimport functools\nimport time\n\n\ndef throttle(seconds):\n    def decorator(func):\n        last = [0.0]\n\n        @functools.wraps(func)\n        def wrapper(*args, **kwargs):\n            now = time.monotonic()\n            if now - last[0] >= seconds:\n                last[0] = now\n                return func(*args, **kwargs)\n        return wrapper\n    return decorator\n```"}]}
