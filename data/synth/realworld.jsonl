{"messages": [{"role": "user", "content": "Write a function to read a CSV of students with name and grade."}, {"role": "silicat", "content": "```python\nimport csv\n\n\ndef read_students(path):\n    with open(path, newline=\"\", encoding=\"utf-8\") as f:\n        return list(csv.DictReader(f))\n```"}, {"role": "user", "content": "Compute the average grade."}, {"role": "silicat", "content": "```python\nimport csv\n\n\ndef average_grade(path):\n    grades = []\n    with open(path, newline=\"\", encoding=\"utf-8\") as f:\n        for row in csv.DictReader(f):\n            grades.append(float(row[\"grade\"]))\n    return sum(grades) / len(grades) if grades else 0\n```"}, {"role": "user", "content": "Find the top student."}, {"role": "silicat", "content": "```python\nimport csv\n\n\ndef top_student(path):\n    with open(path, newline=\"\", encoding=\"utf-8\") as f:\n        return max(csv.DictReader(f), key=lambda r: float(r[\"grade\"]))\n```"}, {"role": "user", "content": "Assign letter grades and write a new CSV."}, {"role": "silicat", "content": "```python\nimport csv\n\n\ndef letter(grade):\n    if grade >= 90:\n        return \"A\"\n    if grade >= 80:\n        return \"B\"\n    if grade >= 70:\n        return \"C\"\n    if grade >= 60:\n        return \"D\"\n    return \"F\"\n\n\ndef add_letters(in_path, out_path):\n    with open(in_path, newline=\"\", encoding=\"utf-8\") as fin:\n        rows = list(csv.DictReader(fin))\n    for row in rows:\n        row[\"letter\"] = letter(float(row[\"grade\"]))\n    fields = list(rows[0].keys()) if rows else [\"name\", \"grade\", \"letter\"]\n    with open(out_path, \"w\", newline=\"\", encoding=\"utf-8\") as fout:\n        writer = csv.DictWriter(fout, fieldnames=fields)\n        writer.writeheader()\n        writer.writerows(rows)\n```"}]}
{"messages": [{"role": "user", "content": "I want to track expenses. Start with a function to add an expense."}, {"role": "silicat", "content": "```python\nexpenses = []\n\n\ndef add_expense(amount, category):\n    expenses.append({\"amount\": amount, \"category\": category})\n```"}, {"role": "user", "content": "Total the expenses."}, {"role": "silicat", "content": "```python\nexpenses = []\n\n\ndef add_expense(amount, category):\n    expenses.append({\"amount\": amount, \"category\": category})\n\n\ndef total():\n    return sum(e[\"amount\"] for e in expenses)\n```"}, {"role": "user", "content": "Break the total down by category."}, {"role": "silicat", "content": "```python\nfrom collections import defaultdict\n\nexpenses = []\n\n\ndef add_expense(amount, category):\n    expenses.append({\"amount\": amount, \"category\": category})\n\n\ndef total():\n    return sum(e[\"amount\"] for e in expenses)\n\n\ndef by_category():\n    totals = defaultdict(float)\n    for e in expenses:\n        totals[e[\"category\"]] += e[\"amount\"]\n    return dict(totals)\n```"}, {"role": "user", "content": "Save and load from a JSON file."}, {"role": "silicat", "content": "```python\nimport json\nimport os\nfrom collections import defaultdict\n\nexpenses = []\n\n\ndef load(path=\"expenses.json\"):\n    global expenses\n    if os.path.exists(path):\n        with open(path, encoding=\"utf-8\") as f:\n            expenses = json.load(f)\n\n\ndef save(path=\"expenses.json\"):\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        json.dump(expenses, f, indent=2)\n\n\ndef add_expense(amount, category):\n    expenses.append({\"amount\": amount, \"category\": category})\n\n\ndef total():\n    return sum(e[\"amount\"] for e in expenses)\n\n\ndef by_category():\n    totals = defaultdict(float)\n    for e in expenses:\n        totals[e[\"category\"]] += e[\"amount\"]\n    return dict(totals)\n```"}]}
{"messages": [{"role": "user", "content": "Help me write a URL shortener in memory."}, {"role": "silicat", "content": "```python\nimport secrets\n\nstore = {}\n\n\ndef shorten(url):\n    code = secrets.token_urlsafe(4)\n    store[code] = url\n    return code\n\n\ndef resolve(code):\n    return store.get(code)\n```"}, {"role": "user", "content": "Make the same URL always return the same code."}, {"role": "silicat", "content": "```python\nimport secrets\n\nstore = {}\nreverse = {}\n\n\ndef shorten(url):\n    if url in reverse:\n        return reverse[url]\n    code = secrets.token_urlsafe(4)\n    store[code] = url\n    reverse[url] = code\n    return code\n\n\ndef resolve(code):\n    return store.get(code)\n```"}, {"role": "user", "content": "Persist the mapping to a JSON file."}, {"role": "silicat", "content": "```python\nimport json\nimport os\nimport secrets\n\nPATH = \"urls.json\"\nstore = {}\nreverse = {}\n\n\ndef load():\n    global store, reverse\n    if os.path.exists(PATH):\n        with open(PATH, encoding=\"utf-8\") as f:\n            store = json.load(f)\n        reverse = {v: k for k, v in store.items()}\n\n\ndef _save():\n    with open(PATH, \"w\", encoding=\"utf-8\") as f:\n        json.dump(store, f, indent=2)\n\n\ndef shorten(url):\n    if url in reverse:\n        return reverse[url]\n    code = secrets.token_urlsafe(4)\n    store[code] = url\n    reverse[url] = code\n    _save()\n    return code\n\n\ndef resolve(code):\n    return store.get(code)\n```"}]}
{"messages": [{"role": "user", "content": "Write a function to find files by extension."}, {"role": "silicat", "content": "```python\nfrom pathlib import Path\n\n\ndef find_by_ext(directory, ext):\n    return list(Path(directory).rglob(f\"*.{ext.lstrip('.')}\"))\n```"}, {"role": "user", "content": "Now group them by their immediate parent folder."}, {"role": "silicat", "content": "```python\nfrom collections import defaultdict\nfrom pathlib import Path\n\n\ndef group_by_folder(directory, ext):\n    groups = defaultdict(list)\n    for f in Path(directory).rglob(f\"*.{ext.lstrip('.')}\"):\n        groups[f.parent.name].append(f.name)\n    return dict(groups)\n```"}, {"role": "user", "content": "Print a summary of counts per folder."}, {"role": "silicat", "content": "```python\nfrom collections import defaultdict\nfrom pathlib import Path\n\n\ndef summary(directory, ext):\n    groups = defaultdict(int)\n    for f in Path(directory).rglob(f\"*.{ext.lstrip('.')}\"):\n        groups[f.parent.name] += 1\n    for folder, count in sorted(groups.items()):\n        print(f\"{folder}: {count}\")\n```"}]}
{"messages": [{"role": "user", "content": "Write a function to fetch a web page's HTML."}, {"role": "silicat", "content": "```python\nimport requests\n\n\ndef fetch_html(url):\n    resp = requests.get(url, timeout=10)\n    resp.raise_for_status()\n    return resp.text\n```"}, {"role": "user", "content": "Extract all the image URLs."}, {"role": "silicat", "content": "```python\nimport requests\nfrom bs4 import BeautifulSoup\n\n\ndef image_urls(url):\n    resp = requests.get(url, timeout=10)\n    resp.raise_for_status()\n    soup = BeautifulSoup(resp.text, \"html.parser\")\n    return [img[\"src\"] for img in soup.find_all(\"img\", src=True)]\n```"}, {"role": "user", "content": "Download them all to a folder."}, {"role": "silicat", "content": "```python\nfrom pathlib import Path\nfrom urllib.parse import urljoin, urlparse\n\nimport requests\nfrom bs4 import BeautifulSoup\n\n\ndef download_images(url, dest):\n    Path(dest).mkdir(parents=True, exist_ok=True)\n    resp = requests.get(url, timeout=10)\n    resp.raise_for_status()\n    soup = BeautifulSoup(resp.text, \"html.parser\")\n    for img in soup.find_all(\"img\", src=True):\n        img_url = urljoin(url, img[\"src\"])\n        name = Path(urlparse(img_url).path).name or \"image\"\n        try:\n            data = requests.get(img_url, timeout=10).content\n            (Path(dest) / name).write_bytes(data)\n        except requests.RequestException:\n            continue\n```"}]}
{"messages": [{"role": "user", "content": "Make a simple note taking function that appends notes to a file."}, {"role": "silicat", "content": "```python\ndef add_note(text, path=\"notes.txt\"):\n    with open(path, \"a\", encoding=\"utf-8\") as f:\n        f.write(text + \"\\n\")\n```"}, {"role": "user", "content": "Timestamp each note."}, {"role": "silicat", "content": "```python\nfrom datetime import datetime\n\n\ndef add_note(text, path=\"notes.txt\"):\n    stamp = datetime.now().strftime(\"%Y-%m-%d %H:%M\")\n    with open(path, \"a\", encoding=\"utf-8\") as f:\n        f.write(f\"[{stamp}] {text}\\n\")\n```"}, {"role": "user", "content": "Add a function to search notes for a keyword."}, {"role": "silicat", "content": "```python\nfrom datetime import datetime\n\n\ndef add_note(text, path=\"notes.txt\"):\n    stamp = datetime.now().strftime(\"%Y-%m-%d %H:%M\")\n    with open(path, \"a\", encoding=\"utf-8\") as f:\n        f.write(f\"[{stamp}] {text}\\n\")\n\n\ndef search_notes(keyword, path=\"notes.txt\"):\n    try:\n        with open(path, encoding=\"utf-8\") as f:\n            return [line.rstrip() for line in f if keyword.lower() in line.lower()]\n    except FileNotFoundError:\n        return []\n```"}]}
{"messages": [{"role": "user", "content": "Write a function to hash a password."}, {"role": "silicat", "content": "```python\nimport hashlib\nimport os\n\n\ndef hash_password(password):\n    salt = os.urandom(16)\n    digest = hashlib.pbkdf2_hmac(\"sha256\", password.encode(), salt, 200_000)\n    return f\"{salt.hex()}:{digest.hex()}\"\n```"}, {"role": "user", "content": "Add a verify function."}, {"role": "silicat", "content": "```python\nimport hashlib\nimport hmac\nimport os\n\n\ndef hash_password(password):\n    salt = os.urandom(16)\n    digest = hashlib.pbkdf2_hmac(\"sha256\", password.encode(), salt, 200_000)\n    return f\"{salt.hex()}:{digest.hex()}\"\n\n\ndef verify_password(password, stored):\n    salt_hex, digest_hex = stored.split(\":\")\n    salt = bytes.fromhex(salt_hex)\n    digest = hashlib.pbkdf2_hmac(\"sha256\", password.encode(), salt, 200_000)\n    return hmac.compare_digest(digest.hex(), digest_hex)\n```\n`hmac.compare_digest` avoids timing attacks when comparing the hashes."}]}
{"messages": [{"role": "user", "content": "Write me a basic calculator that takes an expression string."}, {"role": "silicat", "content": "Use a safe approach rather than `eval`. Here's one that handles two operands:\n\n```python\nimport operator\n\nOPS = {\"+\": operator.add, \"-\": operator.sub, \"*\": operator.mul, \"/\": operator.truediv}\n\n\ndef calc(expr):\n    a, op, b = expr.split()\n    return OPS[op](float(a), float(b))\n```"}, {"role": "user", "content": "Make it a loop that keeps reading expressions until I type quit."}, {"role": "silicat", "content": "```python\nimport operator\n\nOPS = {\"+\": operator.add, \"-\": operator.sub, \"*\": operator.mul, \"/\": operator.truediv}\n\n\ndef calc(expr):\n    a, op, b = expr.split()\n    return OPS[op](float(a), float(b))\n\n\ndef main():\n    while True:\n        line = input(\"> \").strip()\n        if line == \"quit\":\n            break\n        try:\n            print(calc(line))\n        except (ValueError, KeyError, ZeroDivisionError) as e:\n            print(f\"Error: {e}\")\n\n\nif __name__ == \"__main__\":\n    main()\n```"}]}
{"messages": [{"role": "user", "content": "Write a function to read a log file and parse each line into fields."}, {"role": "silicat", "content": "If lines look like `DATE TIME LEVEL message`:\n\n```python\ndef parse_log(path):\n    entries = []\n    with open(path, encoding=\"utf-8\") as f:\n        for line in f:\n            parts = line.rstrip().split(\" \", 3)\n            if len(parts) == 4:\n                date, time, level, message = parts\n                entries.append({\"date\": date, \"time\": time, \"level\": level, \"message\": message})\n    return entries\n```"}, {"role": "user", "content": "Count entries by level."}, {"role": "silicat", "content": "```python\nfrom collections import Counter\n\n\ndef count_levels(path):\n    counts = Counter()\n    with open(path, encoding=\"utf-8\") as f:\n        for line in f:\n            parts = line.split(\" \", 3)\n            if len(parts) >= 3:\n                counts[parts[2]] += 1\n    return counts\n```"}, {"role": "user", "content": "Filter to only WARNING and ERROR and write them to a new file."}, {"role": "silicat", "content": "```python\ndef filter_severe(in_path, out_path):\n    with open(in_path, encoding=\"utf-8\") as fin, open(out_path, \"w\", encoding=\"utf-8\") as fout:\n        for line in fin:\n            parts = line.split(\" \", 3)\n            if len(parts) >= 3 and parts[2] in (\"WARNING\", \"ERROR\"):\n                fout.write(line)\n```"}]}
{"messages": [{"role": "user", "content": "Write a Markdown table generator from a list of dicts."}, {"role": "silicat", "content": "```python\ndef md_table(rows):\n    if not rows:\n        return \"\"\n    headers = list(rows[0].keys())\n    lines = [\"| \" + \" | \".join(headers) + \" |\",\n             \"| \" + \" | \".join(\"---\" for _ in headers) + \" |\"]\n    for row in rows:\n        lines.append(\"| \" + \" | \".join(str(row[h]) for h in headers) + \" |\")\n    return \"\\n\".join(lines)\n```"}, {"role": "user", "content": "Write the table to a .md file."}, {"role": "silicat", "content": "```python\ndef write_md_table(rows, path):\n    table = md_table(rows)\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        f.write(table + \"\\n\")\n```"}]}
{"messages": [{"role": "user", "content": "Write a function to count word frequency from stdin."}, {"role": "silicat", "content": "```python\nimport sys\nfrom collections import Counter\n\n\ndef main():\n    counts = Counter(sys.stdin.read().split())\n    for word, n in counts.most_common():\n        print(f\"{n}\\t{word}\")\n\n\nif __name__ == \"__main__\":\n    main()\n```"}, {"role": "user", "content": "Add an argument for the top N words to show."}, {"role": "silicat", "content": "```python\nimport argparse\nimport sys\nfrom collections import Counter\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"-n\", type=int, default=None, help=\"show top N words\")\n    args = parser.parse_args()\n    counts = Counter(sys.stdin.read().split())\n    for word, n in counts.most_common(args.n):\n        print(f\"{n}\\t{word}\")\n\n\nif __name__ == \"__main__\":\n    main()\n```"}]}
{"messages": [{"role": "user", "content": "Make a function to read a CSV into a list of dicts."}, {"role": "silicat", "content": "```python\nimport csv\n\n\ndef load(path):\n    with open(path, newline=\"\", encoding=\"utf-8\") as f:\n        return list(csv.DictReader(f))\n```"}, {"role": "user", "content": "Sort it by a column."}, {"role": "silicat", "content": "```python\nimport csv\n\n\ndef load_sorted(path, column):\n    with open(path, newline=\"\", encoding=\"utf-8\") as f:\n        return sorted(csv.DictReader(f), key=lambda r: r[column])\n```"}, {"role": "user", "content": "Handle the column being numeric so it sorts numerically."}, {"role": "silicat", "content": "```python\nimport csv\n\n\ndef load_sorted(path, column, numeric=False):\n    key = (lambda r: float(r[column])) if numeric else (lambda r: r[column])\n    with open(path, newline=\"\", encoding=\"utf-8\") as f:\n        return sorted(csv.DictReader(f), key=key)\n```"}]}
{"messages": [{"role": "user", "content": "Write a function that generates a daily report header with today's date."}, {"role": "silicat", "content": "```python\nfrom datetime import date\n\n\ndef header():\n    return f\"Daily Report - {date.today():%B %d, %Y}\"\n```"}, {"role": "user", "content": "Add a section that lists items with bullet points."}, {"role": "silicat", "content": "```python\nfrom datetime import date\n\n\ndef build_report(items):\n    lines = [f\"Daily Report - {date.today():%B %d, %Y}\", \"\"]\n    for item in items:\n        lines.append(f\"  - {item}\")\n    return \"\\n\".join(lines)\n```"}, {"role": "user", "content": "Save it to a dated filename."}, {"role": "silicat", "content": "```python\nfrom datetime import date\n\n\ndef build_report(items):\n    lines = [f\"Daily Report - {date.today():%B %d, %Y}\", \"\"]\n    for item in items:\n        lines.append(f\"  - {item}\")\n    return \"\\n\".join(lines)\n\n\ndef save_report(items):\n    filename = f\"report_{date.today():%Y%m%d}.txt\"\n    with open(filename, \"w\", encoding=\"utf-8\") as f:\n        f.write(build_report(items) + \"\\n\")\n    return filename\n```"}]}
{"messages": [{"role": "user", "content": "Write a function to count lines in a file."}, {"role": "silicat", "content": "```python\ndef count_lines(path):\n    with open(path, encoding=\"utf-8\") as f:\n        return sum(1 for _ in f)\n```"}, {"role": "user", "content": "Make it work for many files and return a dict."}, {"role": "silicat", "content": "```python\ndef count_lines_many(paths):\n    return {p: sum(1 for _ in open(p, encoding=\"utf-8\")) for p in paths}\n```"}, {"role": "user", "content": "Make it a CLI that accepts file arguments and prints a total."}, {"role": "silicat", "content": "```python\nimport argparse\n\n\ndef count_lines(path):\n    with open(path, encoding=\"utf-8\") as f:\n        return sum(1 for _ in f)\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"files\", nargs=\"+\")\n    args = parser.parse_args()\n    total = 0\n    for path in args.files:\n        n = count_lines(path)\n        total += n\n        print(f\"{n:>8}  {path}\")\n    print(f\"{total:>8}  total\")\n\n\nif __name__ == \"__main__\":\n    main()\n```"}]}
{"messages": [{"role": "user", "content": "Write a function that validates and normalizes phone numbers."}, {"role": "silicat", "content": "```python\nimport re\n\n\ndef normalize_phone(raw):\n    digits = re.sub(r\"\\D\", \"\", raw)\n    if len(digits) == 10:\n        return f\"+1{digits}\"\n    if len(digits) == 11 and digits.startswith(\"1\"):\n        return f\"+{digits}\"\n    return None\n```"}, {"role": "user", "content": "Process a whole column from a CSV and add a normalized column."}, {"role": "silicat", "content": "```python\nimport csv\nimport re\n\n\ndef normalize_phone(raw):\n    digits = re.sub(r\"\\D\", \"\", raw)\n    if len(digits) == 10:\n        return f\"+1{digits}\"\n    if len(digits) == 11 and digits.startswith(\"1\"):\n        return f\"+{digits}\"\n    return None\n\n\ndef process(in_path, out_path, phone_col):\n    with open(in_path, newline=\"\", encoding=\"utf-8\") as fin:\n        rows = list(csv.DictReader(fin))\n    for row in rows:\n        row[\"normalized_phone\"] = normalize_phone(row[phone_col]) or \"\"\n    fields = list(rows[0].keys()) if rows else [phone_col, \"normalized_phone\"]\n    with open(out_path, \"w\", newline=\"\", encoding=\"utf-8\") as fout:\n        writer = csv.DictWriter(fout, fieldnames=fields)\n        writer.writeheader()\n        writer.writerows(rows)\n```"}]}
{"messages": [{"role": "user", "content": "Write a function to compute the hash of a file."}, {"role": "silicat", "content": "```python\nimport hashlib\n\n\ndef file_hash(path, algo=\"sha256\"):\n    h = hashlib.new(algo)\n    with open(path, \"rb\") as f:\n        while chunk := f.read(8192):\n            h.update(chunk)\n    return h.hexdigest()\n```"}, {"role": "user", "content": "Now compare two directories and report files whose hashes differ."}, {"role": "silicat", "content": "```python\nimport hashlib\nfrom pathlib import Path\n\n\ndef file_hash(path, algo=\"sha256\"):\n    h = hashlib.new(algo)\n    with open(path, \"rb\") as f:\n        while chunk := f.read(8192):\n            h.update(chunk)\n    return h.hexdigest()\n\n\ndef diff_dirs(dir_a, dir_b):\n    a, b = Path(dir_a), Path(dir_b)\n    differing = []\n    for fa in a.rglob(\"*\"):\n        if fa.is_file():\n            rel = fa.relative_to(a)\n            fb = b / rel\n            if not fb.exists() or file_hash(fa) != file_hash(fb):\n                differing.append(str(rel))\n    return differing\n```"}]}
{"messages": [{"role": "user", "content": "Make a function that returns a greeting depending on the time of day."}, {"role": "silicat", "content": "```python\nfrom datetime import datetime\n\n\ndef greeting():\n    hour = datetime.now().hour\n    if hour < 12:\n        return \"Good morning\"\n    if hour < 18:\n        return \"Good afternoon\"\n    return \"Good evening\"\n```"}, {"role": "user", "content": "Let me pass a name in."}, {"role": "silicat", "content": "```python\nfrom datetime import datetime\n\n\ndef greeting(name):\n    hour = datetime.now().hour\n    if hour < 12:\n        part = \"Good morning\"\n    elif hour < 18:\n        part = \"Good afternoon\"\n    else:\n        part = \"Good evening\"\n    return f\"{part}, {name}!\"\n```"}]}
{"messages": [{"role": "user", "content": "Write a simple inventory tracker with add and remove quantity."}, {"role": "silicat", "content": "```python\nfrom collections import defaultdict\n\ninventory = defaultdict(int)\n\n\ndef add(item, qty=1):\n    inventory[item] += qty\n\n\ndef remove(item, qty=1):\n    inventory[item] = max(0, inventory[item] - qty)\n```"}, {"role": "user", "content": "Add a low-stock report below a threshold."}, {"role": "silicat", "content": "```python\nfrom collections import defaultdict\n\ninventory = defaultdict(int)\n\n\ndef add(item, qty=1):\n    inventory[item] += qty\n\n\ndef remove(item, qty=1):\n    inventory[item] = max(0, inventory[item] - qty)\n\n\ndef low_stock(threshold=5):\n    return {item: qty for item, qty in inventory.items() if qty < threshold}\n```"}, {"role": "user", "content": "Persist the inventory to a JSON file and load it on import."}, {"role": "silicat", "content": "```python\nimport json\nimport os\nfrom collections import defaultdict\n\nPATH = \"inventory.json\"\ninventory = defaultdict(int)\n\n\ndef _load():\n    if os.path.exists(PATH):\n        with open(PATH, encoding=\"utf-8\") as f:\n            inventory.update(json.load(f))\n\n\ndef _save():\n    with open(PATH, \"w\", encoding=\"utf-8\") as f:\n        json.dump(dict(inventory), f, indent=2)\n\n\ndef add(item, qty=1):\n    inventory[item] += qty\n    _save()\n\n\ndef remove(item, qty=1):\n    inventory[item] = max(0, inventory[item] - qty)\n    _save()\n\n\ndef low_stock(threshold=5):\n    return {item: qty for item, qty in inventory.items() if qty < threshold}\n\n\n_load()\n```"}]}
