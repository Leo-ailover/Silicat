{"messages": [{"role": "user", "content": "read a file and return the average words per line"}, {"role": "silicat", "content": "```python\ndef avg_words_per_line(path):\n    total = lines = 0\n    with open(path, encoding=\"utf-8\") as f:\n        for line in f:\n            total += len(line.split())\n            lines += 1\n    return total / lines if lines else 0\n```"}]}
{"messages": [{"role": "user", "content": "Write a function to remove blank lines from a file."}, {"role": "silicat", "content": "```python\ndef remove_blank_lines(path):\n    with open(path, encoding=\"utf-8\") as f:\n        lines = [line for line in f if line.strip()]\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        f.writelines(lines)\n```"}]}
{"messages": [{"role": "user", "content": "count the number of times a regex group captures across a file"}, {"role": "silicat", "content": "```python\nimport re\nfrom collections import Counter\n\n\ndef capture_counts(path, pattern):\n    regex = re.compile(pattern)\n    counts = Counter()\n    with open(path, encoding=\"utf-8\") as f:\n        for line in f:\n            counts.update(regex.findall(line))\n    return counts\n```"}]}
{"messages": [{"role": "user", "content": "Write a function to convert a flat dict to nested using dotted keys."}, {"role": "silicat", "content": "```python\ndef unflatten(flat, sep=\".\"):\n    result = {}\n    for key, value in flat.items():\n        parts = key.split(sep)\n        d = result\n        for part in parts[:-1]:\n            d = d.setdefault(part, {})\n        d[parts[-1]] = value\n    return result\n```"}]}
{"messages": [{"role": "user", "content": "read a file and print only lines that are not duplicates"}, {"role": "silicat", "content": "```python\ndef print_unique(path):\n    seen = set()\n    with open(path, encoding=\"utf-8\") as f:\n        for line in f:\n            if line not in seen:\n                seen.add(line)\n                print(line, end=\"\")\n```"}]}
{"messages": [{"role": "user", "content": "Write a function to compute the entropy of a string."}, {"role": "silicat", "content": "```python\nimport math\nfrom collections import Counter\n\n\ndef entropy(s):\n    if not s:\n        return 0.0\n    counts = Counter(s)\n    n = len(s)\n    return -sum((c / n) * math.log2(c / n) for c in counts.values())\n```"}]}
{"messages": [{"role": "user", "content": "convert a list to a set and report how many duplicates were removed"}, {"role": "silicat", "content": "```python\ndef count_duplicates(items):\n    return len(items) - len(set(items))\n```"}]}
