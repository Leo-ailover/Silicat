{"messages": [{"role": "user", "content": "Implement bubble sort"}, {"role": "silicat", "content": "def bubble_sort(arr):\n    for i in range(len(arr)):\n        for j in range(len(arr) - i - 1):\n            if arr[j] > arr[j+1]:\n                arr[j], arr[j+1] = arr[j+1], arr[j]\n    return arr"}]}
{"messages": [{"role": "user", "content": "Bubble sort complexity"}, {"role": "silicat", "content": "O(n\u00b2) worst/avg, O(n) best, O(1) space, stable"}]}
{"messages": [{"role": "user", "content": "Insertion sort"}, {"role": "silicat", "content": "def insertion_sort(arr):\n    for i in range(1, len(arr)):\n        key = arr[i]\n        j = i - 1\n        while j >= 0 and arr[j] > key:\n            arr[j+1] = arr[j]\n            j -= 1\n        arr[j+1] = key\n    return arr"}]}
{"messages": [{"role": "user", "content": "Merge sort"}, {"role": "silicat", "content": "def merge_sort(arr):\n    if len(arr) <= 1:\n        return arr\n    mid = len(arr) // 2\n    return merge(merge_sort(arr[:mid]), merge_sort(arr[mid:]))"}]}
{"messages": [{"role": "user", "content": "Merge sort complexity"}, {"role": "silicat", "content": "O(n log n) all cases, O(n) space, stable, divide-conquer"}]}
{"messages": [{"role": "user", "content": "Quick sort"}, {"role": "silicat", "content": "def quick_sort(arr):\n    if len(arr) <= 1:\n        return arr\n    pivot = arr[len(arr)//2]\n    left = [x for x in arr if x < pivot]\n    mid = [x for x in arr if x == pivot]\n    right = [x for x in arr if x > pivot]\n    return quick_sort(left) + mid + quick_sort(right)"}]}
{"messages": [{"role": "user", "content": "Quick sort complexity"}, {"role": "silicat", "content": "O(n log n) avg, O(n\u00b2) worst, O(log n) space avg, unstable, in-place"}]}
{"messages": [{"role": "user", "content": "Heap sort"}, {"role": "silicat", "content": "def heap_sort(arr):\n    heapq.heapify(arr)\n    return [heapq.heappop(arr) for _ in range(len(arr))]"}]}
{"messages": [{"role": "user", "content": "Heap sort complexity"}, {"role": "silicat", "content": "O(n log n) all cases, O(1) space, unstable"}]}
{"messages": [{"role": "user", "content": "Selection sort"}, {"role": "silicat", "content": "def selection_sort(arr):\n    for i in range(len(arr)):\n        min_idx = min(range(i, len(arr)), key=arr.__getitem__)\n        arr[i], arr[min_idx] = arr[min_idx], arr[i]\n    return arr"}]}
{"messages": [{"role": "user", "content": "Selection sort complexity"}, {"role": "silicat", "content": "O(n\u00b2) all cases, O(1) space, unstable"}]}
{"messages": [{"role": "user", "content": "Counting sort"}, {"role": "silicat", "content": "def counting_sort(arr):\n    counts = {}\n    for x in arr:\n        counts[x] = counts.get(x, 0) + 1\n    result = []\n    for x in sorted(counts):\n        result.extend([x] * counts[x])\n    return result"}]}
{"messages": [{"role": "user", "content": "Counting sort complexity"}, {"role": "silicat", "content": "O(n + k) where k is range, O(k) space, stable, non-comparative"}]}
{"messages": [{"role": "user", "content": "When to use each sort"}, {"role": "silicat", "content": "Bubble: small/sorted. Insertion: small/nearly sorted. Merge: stable/external. Quick: general. Heap: guaranteed. Counting: integers."}]}
{"messages": [{"role": "user", "content": "Binary search"}, {"role": "silicat", "content": "def binary_search(arr, target):\n    left, right = 0, len(arr) - 1\n    while left <= right:\n        mid = (left + right) // 2\n        if arr[mid] == target:\n            return mid\n        elif arr[mid] < target:\n            left = mid + 1\n        else:\n            right = mid - 1\n    return -1"}]}
{"messages": [{"role": "user", "content": "Binary search complexity"}, {"role": "silicat", "content": "O(log n) time, O(1) space, requires sorted array"}]}
{"messages": [{"role": "user", "content": "Linear search"}, {"role": "silicat", "content": "def linear_search(arr, target):\n    for i, val in enumerate(arr):\n        if val == target:\n            return i\n    return -1"}]}
{"messages": [{"role": "user", "content": "Linear search complexity"}, {"role": "silicat", "content": "O(n) time, O(1) space, works on unsorted"}]}
{"messages": [{"role": "user", "content": "Ternary search"}, {"role": "silicat", "content": "def ternary_search(arr, target):\n    left, right = 0, len(arr) - 1\n    while left <= right:\n        mid1 = left + (right - left) // 3\n        mid2 = right - (right - left) // 3\n        if arr[mid1] == target:\n            return mid1\n        if arr[mid2] == target:\n            return mid2\n        if target < arr[mid1]:\n            right = mid1 - 1\n        elif target > arr[mid2]:\n            left = mid2 + 1\n        else:\n            left, right = mid1 + 1, mid2 - 1\n    return -1"}]}
{"messages": [{"role": "user", "content": "Find leftmost"}, {"role": "silicat", "content": "Binary search variant tracking result when found"}]}
{"messages": [{"role": "user", "content": "Find rightmost"}, {"role": "silicat", "content": "Binary search variant continue searching right"}]}
{"messages": [{"role": "user", "content": "bisect module usage"}, {"role": "silicat", "content": "import bisect\npos = bisect.bisect_left(arr, val)\npos = bisect.bisect_right(arr, val)\nbisect.insort(arr, val)"}]}
{"messages": [{"role": "user", "content": "Jump search"}, {"role": "silicat", "content": "Jump by sqrt(n) blocks then linear. O(sqrt n)."}]}
{"messages": [{"role": "user", "content": "Exponential search"}, {"role": "silicat", "content": "Jump powers of 2 then binary search unbounded arrays"}]}
{"messages": [{"role": "user", "content": "Recursion base case"}, {"role": "silicat", "content": "Condition stopping recursion, prevents infinite loop"}]}
{"messages": [{"role": "user", "content": "Factorial recursive"}, {"role": "silicat", "content": "def factorial(n):\n    return 1 if n <= 1 else n * factorial(n - 1)"}]}
{"messages": [{"role": "user", "content": "Fibonacci recursive"}, {"role": "silicat", "content": "def fib(n):\n    return n if n <= 1 else fib(n-1) + fib(n-2)"}]}
{"messages": [{"role": "user", "content": "Memoization pattern"}, {"role": "silicat", "content": "Cache results, solve once. def fib(n, memo={}):\n    if n in memo:\n        return memo[n]\n    memo[n] = fib(n-1, memo) + fib(n-2, memo)\n    return memo[n]"}]}
{"messages": [{"role": "user", "content": "lru_cache decorator"}, {"role": "silicat", "content": "from functools import lru_cache\n@lru_cache(maxsize=None)\ndef fib(n):\n    return n if n <= 1 else fib(n-1) + fib(n-2)"}]}
{"messages": [{"role": "user", "content": "Tail recursion"}, {"role": "silicat", "content": "Last operation is recursive call, can optimize to loop"}]}
{"messages": [{"role": "user", "content": "Sum array recursively"}, {"role": "silicat", "content": "def sum_arr(arr, i=0):\n    return 0 if i == len(arr) else arr[i] + sum_arr(arr, i+1)"}]}
{"messages": [{"role": "user", "content": "Power fast exponential"}, {"role": "silicat", "content": "def power(base, exp):\n    if exp == 0:\n        return 1\n    half = power(base, exp // 2)\n    return half * half if exp % 2 == 0 else half * half * base"}]}
