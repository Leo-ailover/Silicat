{"messages": [{"role": "user", "content": "Deque usage"}, {"role": "silicat", "content": "from collections import deque\nd = deque()\nd.append(x)  # O(1) right\nd.appendleft(x)  # O(1) left\nd.pop()  # O(1) right\nd.popleft()  # O(1) left"}]}
