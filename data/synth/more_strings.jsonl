{"messages": [{"role": "user", "content": "Queue implementation"}, {"role": "silicat", "content": "class Queue:\n    def __init__(self):\n        self.items = []\n    def enqueue(self, x):\n        self.items.append(x)\n    def dequeue(self):\n        return self.items.pop(0) if self.items else None"}]}
